{
  "submit_url": "https://cannjudge.cn/public/op_challenge_jingdong_prelim/rotaryposemb/submit",
  "history_url": "https://cannjudge.cn/public/op_challenge_jingdong_prelim/rotaryposemb",
  "allowed_origin": "https://cannjudge.cn",
  "calibrated": true,
  "editor_adapter": "keyboard",
  "editor_selector": "#editor-main .monaco-editor textarea",
  "editor_copy_selector": "[data-action='copy-current-code']",
  "editor_file_selector": ".open-editor-tree-row.is-file",
  "submit_button_name": "提交代码",
  "result_link_selector": "a[href*='/rotaryposemb/submission/']",
  "result_url_pattern": "/public/op_challenge_jingdong_prelim/rotaryposemb/submission/[a-f0-9]{24}$",
  "result_id_selector": ".open-submission-meta-line > span:first-child",
  "result_id_pattern": "^提交 ID[：:]\\s*(\\d+)$",
  "result_identity": "source_and_url",
  "result_status_selector": "#submission-status-cell .open-status-chip",
  "result_kernel_tab_selector": "[data-action='switch-submission-file'][data-file='kernel.asc']",
  "result_code_selector": "#submission-code",
  "result_source_final_newline": true,
  "case_row_selector": "#submission-result-tbody > tr",
  "case_id_selector": "td:nth-child(1)",
  "case_status_selector": "td:nth-child(2)",
  "case_error_selector": "td:nth-child(3)",
  "case_max_error_percent": 1.0,
  "case_latency_selector": "td:nth-child(4)",
  "case_best_latency_selector": "td:nth-child(5)",
  "log_selector": "#submission-status-msg-content",
  "score_selector": null,
  "ranking_url": "https://cannjudge.cn/public/op_challenge_jingdong_prelim/rotaryposemb/ranking",
  "ranking_search_selector": "#problem-ranking-search-input",
  "ranking_row_selector": ".open-problem-rank-table tbody > tr",
  "result_submitter_selector": ".open-submission-meta-line > span:nth-child(2)",
  "result_time_selector": ".open-submission-meta-line > span:nth-child(3)",
  "require_official_score": true,
  "expected_cases": 15,
  "poll_seconds": 60,
  "result_timeout_seconds": 1800,
  "allow_partial_results": true,
  "case_pending_statuses": ["", "-", "Pending", "Waiting", "Running", "Judging", "Compiling", "排队中", "编译中", "运行中", "评测中"],
  "success_statuses": ["Pass"],
  "failure_statuses": ["Compile Error", "Wrong Answer", "Runtime Error", "Time Limit Exceeded", "Memory Limit Exceeded", "System Error", "Judgement Failed"],
  "case_success_statuses": ["Pass"]
}
