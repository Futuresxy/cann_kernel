// Development-only trace. Production kernel, reference and timing are untouched.
#include <algorithm>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <fstream>
#include <limits>
#include <string>
#include <vector>
#include "acl/acl.h"
#include "v9_traced_math.h"
#include "../../../tests/launch_audit.h"
using namespace AscendC;

__global__ __vector__ void trig_internal_probe(GM_ADDR x,GM_ADDR positions,GM_ADDR trace,GM_ADDR y,
    uint32_t tokens,uint32_t heads,uint32_t dim,uint32_t tile,uint32_t batch,float theta) {
    // Match the previously calibrated probe's work/trig offsets and V9 tiling.
    TPipe pipe;TBuf<TPosition::VECCALC> workBuf,trigBuf;
    TBuf<TPosition::VECIN> inputBuf;TBuf<TPosition::VECOUT> outputBuf;
    uint32_t halfDim=dim/2,freqSize=(halfDim+7)/8*8,size=tile*dim,stride=size+8;
    uint32_t cacheSize=batch*freqSize;
    pipe.InitBuffer(workBuf,2*stride*4);pipe.InitBuffer(trigBuf,(freqSize+3*cacheSize)*4);
    pipe.InitBuffer(inputBuf,size*2);pipe.InitBuffer(outputBuf,size*2);
    auto z=workBuf.Get<float>(),r=z[stride];
    auto freq=trigBuf.Get<float>(),c=freq[freqSize],s=c[cacheSize],angle=s[cacheSize];
    auto input=inputBuf.Get<half>(),output=outputBuf.Get<half>();
    GlobalTensor<half> gx,gy;GlobalTensor<int32_t> gp;GlobalTensor<float> gt;
    gx.SetGlobalBuffer((__gm__ half*)x);gp.SetGlobalBuffer((__gm__ int32_t*)positions);
    gy.SetGlobalBuffer((__gm__ half*)y);gt.SetGlobalBuffer((__gm__ float*)trace);
    uint32_t cores=GetBlockNum(),core=GetBlockIdx(),groups=(heads+tile-1)/tile;
    uint64_t jobs=uint64_t(tokens)*groups,begin=jobs*core/cores,end=jobs*(core+1)/cores;
    uint32_t firstToken=begin/groups;
    uint64_t traceBase=uint64_t(core)*rope1743::TRACE_STAGES*rope1743::TRACE_STRIDE;
    rope1743::Frequencies f{theta};
    rope1743::FillFrequencies(freq,f,halfDim,freqSize,z);
    uint64_t cached=uint64_t(-1);uint32_t cachedCount=0;
    uint8_t rowStride=dim/8;
    BinaryRepeatParams broadcast{1,1,1,rowStride,rowStride,0};
    for(uint64_t job=begin;job<end;++job) {
        uint32_t token=job/groups,head=(job%groups)*tile,rows=heads-head;if(rows>tile)rows=tile;
        uint32_t count=rows*dim;uint64_t offset=(uint64_t(token)*heads+head)*dim;
        int32_t position=gp.GetValue(token);
        if(position!=0 && (cached==uint64_t(-1)||token>=cached+cachedCount)) {
            uint64_t limit=(end-1)/groups+1;cachedCount=limit-token<batch?limit-token:batch;
            for(uint32_t b=0;b<cachedCount;++b)
                Muls(angle[b*freqSize],freq,float(gp.GetValue(token+b)),freqSize);
            rope1743::TraceSinCosFp32(angle,c,s,z,r,cachedCount*freqSize,gt,
                traceBase+uint64_t(token-firstToken)*freqSize);
            Muls(angle,s,-1.0f,cachedCount*freqSize);cached=token;
        }
        DataCopy(input,gx[offset],count);PipeBarrier<PIPE_ALL>();
        if(position==0)DataCopy(output,input,count);
        else {
            rope1743::LoadFp32(z,input,count);
            uint32_t off=(token-cached)*freqSize;
            for(uint32_t col=0;col<halfDim;col+=64) {
                uint64_t mask=halfDim-col<64?halfDim-col:64;
                Mul(r[col],z[col],c[off+col],mask,rows,broadcast);
                Mul(r[halfDim+col],z[halfDim+col],c[off+col],mask,rows,broadcast);
            }
            for(uint32_t col=0;col<halfDim;col+=64) {
                uint64_t mask=halfDim-col<64?halfDim-col:64;
                MulAddDst(r[col],z[halfDim+col],angle[off+col],mask,rows,broadcast);
                MulAddDst(r[halfDim+col],z[col],s[off+col],mask,rows,broadcast);
            }
            rope1743::StoreFp32(output,r,count);
        }
        PipeBarrier<PIPE_ALL>();DataCopy(gy[offset],output,count);PipeBarrier<PIPE_ALL>();
    }
}

#define CHECK(expr) do {auto rc=(expr);if(rc!=ACL_SUCCESS){fprintf(stderr,"%s: %d\n",#expr,int(rc));return 2;}}while(0)
int main(int argc,char** argv) {
    if(argc<4){fprintf(stderr,"trig_internal_probe INPUT_DIR TRACE_FLOATS OUTPUT_HALF [--device N]\n");return 1;}
    int device=0;for(int i=4;i+1<argc;++i)if(std::string(argv[i])=="--device")device=std::atoi(argv[++i]);
    constexpr uint32_t tokens=137,heads=17,dim=1024,tile=9,batch=9;constexpr float theta=10000.f;
    std::vector<half> x(uint64_t(tokens)*heads*dim);std::vector<int32_t> p(tokens);
    auto read=[](const std::string& path,void* dst,size_t bytes){std::ifstream f(path,std::ios::binary);f.read((char*)dst,bytes);return bool(f);};
    if(!read(std::string(argv[1])+"/x.bin",x.data(),x.size()*2)||!read(std::string(argv[1])+"/positions.bin",p.data(),p.size()*4))return 1;
    CHECK(aclInit(nullptr));CHECK(aclrtSetDevice(device));int64_t available;CHECK(aclrtGetDeviceInfo(device,ACL_DEV_ATTR_VECTOR_CORE_NUM,&available));
    uint32_t cores=std::min<uint64_t>(available,uint64_t(tokens)*((heads+tile-1)/tile));
    uint32_t groups=(heads+tile-1)/tile;uint64_t jobs=uint64_t(tokens)*groups;
    for(uint32_t core=0;core<cores;++core) {
        uint64_t begin=jobs*core/cores,end=jobs*(core+1)/cores;
        if((end-1)/groups-begin/groups+1>rope1743::TRACE_SLOTS)return 3;
    }
    uint64_t floats=uint64_t(cores)*rope1743::TRACE_STAGES*rope1743::TRACE_STRIDE;
    // Explicit sentinel initialization; absent samples never read stale GM.
    std::vector<float> result(floats,std::numeric_limits<float>::quiet_NaN());
    std::vector<half> y(x.size());void *dx,*dp,*dr,*dy;
    CHECK(aclrtMalloc(&dx,x.size()*2,ACL_MEM_MALLOC_HUGE_FIRST));CHECK(aclrtMalloc(&dp,p.size()*4,ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK(aclrtMalloc(&dr,result.size()*4,ACL_MEM_MALLOC_HUGE_FIRST));CHECK(aclrtMalloc(&dy,y.size()*2,ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK(aclrtMemcpy(dx,x.size()*2,x.data(),x.size()*2,ACL_MEMCPY_HOST_TO_DEVICE));CHECK(aclrtMemcpy(dp,p.size()*4,p.data(),p.size()*4,ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK(aclrtMemcpy(dr,result.size()*4,result.data(),result.size()*4,ACL_MEMCPY_HOST_TO_DEVICE));
    aclrtStream stream;CHECK(aclrtCreateStream(&stream));uint64_t before=ropeActualKernelLaunches;
    trig_internal_probe<<<cores,nullptr,stream>>>((GM_ADDR)dx,(GM_ADDR)dp,(GM_ADDR)dr,(GM_ADDR)dy,tokens,heads,dim,tile,batch,theta);
    CHECK(aclrtSynchronizeStreamWithTimeout(stream,30000));
    if(ropeActualKernelLaunches-before!=1)return 3;
    CHECK(aclrtMemcpy(result.data(),result.size()*4,dr,result.size()*4,ACL_MEMCPY_DEVICE_TO_HOST));CHECK(aclrtMemcpy(y.data(),y.size()*2,dy,y.size()*2,ACL_MEMCPY_DEVICE_TO_HOST));
    std::ofstream raw(argv[2],std::ios::binary);raw.write((char*)result.data(),result.size()*4);
    std::ofstream output(argv[3],std::ios::binary);output.write((char*)y.data(),y.size()*2);if(!raw||!output)return 1;
    printf("{\"device\":%d,\"soc\":\"%s\",\"cores\":%u,\"tokens\":%u,\"heads\":%u,\"dim\":%u,\"tile_heads\":%u,\"trig_batch\":%u,\"trace_slots\":%u,\"trace_stage_count\":%u,\"float_count\":%llu,\"device_kernel_launches\":1,\"diagnostic_only\":true}\n",device,aclrtGetSocName(),cores,tokens,heads,dim,tile,batch,rope1743::TRACE_SLOTS,rope1743::TRACE_STAGES,(unsigned long long)floats);
    CHECK(aclrtFree(dx));CHECK(aclrtFree(dp));CHECK(aclrtFree(dr));CHECK(aclrtFree(dy));CHECK(aclrtDestroyStream(stream));CHECK(aclrtResetDevice(device));CHECK(aclFinalize());return 0;
}
