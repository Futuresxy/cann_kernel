// Development-only stage export. No competition source/harness is modified.
#include <algorithm>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <fstream>
#include <string>
#include <vector>
#include "acl/acl.h"
#include "v9_math_snapshot.h"
#include "../../../tests/launch_audit.h"
using namespace AscendC;

__global__ __vector__ void stage_probe(GM_ADDR x,GM_ADDR positions,GM_ADDR dump,GM_ADDR y,
    uint32_t tokens,uint32_t heads,uint32_t dim,uint32_t tile,uint32_t batch,float theta) {
    // These allocations reproduce V9 LargeAlignedRotary's sizes/offsets. One
    // input slot suffices for diagnostics; timing is never used as performance.
    TPipe pipe;TBuf<TPosition::VECCALC> workBuf,trigBuf;
    TBuf<TPosition::VECIN> inputBuf;TBuf<TPosition::VECOUT> outputBuf;
    uint32_t halfDim=dim/2,freqSize=(halfDim+7)/8*8,size=tile*dim,stride=size+8;
    uint32_t cacheSize=batch*freqSize;
    pipe.InitBuffer(workBuf,2*stride*4);
    pipe.InitBuffer(trigBuf,(freqSize+3*cacheSize)*4);
    pipe.InitBuffer(inputBuf,size*2);pipe.InitBuffer(outputBuf,size*2);
    auto work=workBuf.Get<float>(),z=work,r=work[stride];
    auto freq=trigBuf.Get<float>(),c=freq[freqSize],s=c[cacheSize],angle=s[cacheSize];
    auto input=inputBuf.Get<half>(),output=outputBuf.Get<half>();
    auto temporary=output.ReinterpretCast<float>();
    GlobalTensor<half> gx,gy;GlobalTensor<int32_t> gp;GlobalTensor<float> gd;
    gx.SetGlobalBuffer((__gm__ half*)x);gp.SetGlobalBuffer((__gm__ int32_t*)positions);
    gy.SetGlobalBuffer((__gm__ half*)y);gd.SetGlobalBuffer((__gm__ float*)dump);
    uint32_t cores=GetBlockNum(),core=GetBlockIdx();
    uint64_t frequencyOffset=0,angleOffset=uint64_t(cores)*freqSize;
    uint64_t stageSize=uint64_t(tokens)*halfDim;
    uint64_t reducedOffset=angleOffset+stageSize,quotientOffset=reducedOffset+stageSize;
    uint64_t cosineOffset=quotientOffset+stageSize,sineOffset=cosineOffset+stageSize;
    uint64_t productOffset=sineOffset+stageSize;
    uint64_t elements=uint64_t(tokens)*heads*dim,crossOffset=productOffset+elements,fp32Offset=crossOffset+elements;
    uint32_t groups=(heads+tile-1)/tile;
    uint64_t jobs=uint64_t(tokens)*groups,begin=jobs*core/cores,end=jobs*(core+1)/cores;
    rope1743::Frequencies f{theta};
    rope1743::FillFrequencies(freq,f,halfDim,freqSize,work);
    DataCopy(gd[frequencyOffset+uint64_t(core)*freqSize],freq,freqSize);PipeBarrier<PIPE_ALL>();
    uint64_t cached=uint64_t(-1);uint32_t cachedCount=0;
    uint8_t rowStride=dim/8;
    BinaryRepeatParams broadcast{1,1,1,rowStride,rowStride,0};
    BinaryRepeatParams packedCross{1,1,1,uint8_t(halfDim/8),rowStride,0};
    rope1743::FloatBits nan;nan.bits=0x7fc00000u;
    for(uint64_t job=begin;job<end;++job) {
        uint32_t token=job/groups,head=(job%groups)*tile,rows=heads-head;if(rows>tile)rows=tile;
        uint32_t count=rows*dim;uint64_t offset=(uint64_t(token)*heads+head)*dim;
        int32_t position=gp.GetValue(token);
        if(position!=0 && (cached==uint64_t(-1)||token>=cached+cachedCount)) {
            uint64_t limit=(end-1)/groups+1;cachedCount=limit-token<batch?limit-token:batch;
            for(uint32_t b=0;b<cachedCount;++b)
                Muls(angle[b*freqSize],freq,float(gp.GetValue(token+b)),freqSize);
            rope1743::SinCosFp32(angle,c,s,z,r,cachedCount*freqSize);
            Muls(angle,s,-1.0f,cachedCount*freqSize);cached=token;
        }
        uint32_t trigOffset=position!=0?(token-cached)*freqSize:0;
        if(head==0) {
            // One owner per token. Re-evaluate only the exact unchanged range
            // reducer for diagnosis; the rotation uses the original SinCos call.
            Muls(z,freq,float(position),halfDim);
            PipeBarrier<PIPE_ALL>();DataCopy(gd[angleOffset+uint64_t(token)*halfDim],z,halfDim);PipeBarrier<PIPE_ALL>();
            Muls(r,z,0.15915494309189535f,halfDim);
            Cast(r[halfDim].ReinterpretCast<int32_t>(),r,RoundMode::CAST_RINT,halfDim);
            Cast(r,r[halfDim].ReinterpretCast<int32_t>(),RoundMode::CAST_NONE,halfDim);
            PipeBarrier<PIPE_ALL>();DataCopy(gd[quotientOffset+uint64_t(token)*halfDim],r,halfDim);PipeBarrier<PIPE_ALL>();
            Muls(r[halfDim],r,6.25f,halfDim);Sub(z,z,r[halfDim],halfDim);
            Muls(r[halfDim],r,0.033203125f,halfDim);Sub(z,z,r[halfDim],halfDim);
            Muls(r[halfDim],r,-0.000017817820413523074f,halfDim);Sub(z,z,r[halfDim],halfDim);
            PipeBarrier<PIPE_ALL>();DataCopy(gd[reducedOffset+uint64_t(token)*halfDim],z,halfDim);PipeBarrier<PIPE_ALL>();
            if(position!=0) {
                DataCopy(gd[cosineOffset+uint64_t(token)*halfDim],c[trigOffset],halfDim);
                DataCopy(gd[sineOffset+uint64_t(token)*halfDim],s[trigOffset],halfDim);
            } else {
                Duplicate(z,nan.value,halfDim);PipeBarrier<PIPE_ALL>();
                DataCopy(gd[cosineOffset+uint64_t(token)*halfDim],z,halfDim);
                DataCopy(gd[sineOffset+uint64_t(token)*halfDim],z,halfDim);
            }
            PipeBarrier<PIPE_ALL>();
        }
        DataCopy(input,gx[offset],count);PipeBarrier<PIPE_ALL>();
        rope1743::LoadFp32(z,input,count);
        if(position==0) {
            PipeBarrier<PIPE_ALL>();DataCopy(gd[fp32Offset+offset],z,count);PipeBarrier<PIPE_ALL>();
            Duplicate(r,nan.value,count);PipeBarrier<PIPE_ALL>();
            DataCopy(gd[productOffset+offset],r,count);DataCopy(gd[crossOffset+offset],r,count);
            DataCopy(output,input,count);
        } else {
            for(uint32_t col=0;col<halfDim;col+=64) {
                uint64_t mask=halfDim-col<64?halfDim-col:64;
                Mul(r[col],z[col],c[trigOffset+col],mask,rows,broadcast);
                Mul(r[halfDim+col],z[halfDim+col],c[trigOffset+col],mask,rows,broadcast);
            }
            PipeBarrier<PIPE_ALL>();DataCopy(gd[productOffset+offset],r,count);PipeBarrier<PIPE_ALL>();
            // The original r/z vectors remain intact. The output queue storage
            // is temporarily reused to export each separately rounded product.
            for(uint32_t col=0;col<halfDim;col+=64) {
                uint64_t mask=halfDim-col<64?halfDim-col:64;
                Mul(temporary[col],z[halfDim+col],angle[trigOffset+col],mask,rows,packedCross);
            }
            PipeBarrier<PIPE_ALL>();
            for(uint32_t row=0;row<rows;++row)DataCopy(gd[crossOffset+offset+row*dim],temporary[row*halfDim],halfDim);
            PipeBarrier<PIPE_ALL>();
            for(uint32_t col=0;col<halfDim;col+=64) {
                uint64_t mask=halfDim-col<64?halfDim-col:64;
                Mul(temporary[col],z[col],s[trigOffset+col],mask,rows,packedCross);
            }
            PipeBarrier<PIPE_ALL>();
            for(uint32_t row=0;row<rows;++row)DataCopy(gd[crossOffset+offset+row*dim+halfDim],temporary[row*halfDim],halfDim);
            PipeBarrier<PIPE_ALL>();
            for(uint32_t col=0;col<halfDim;col+=64) {
                uint64_t mask=halfDim-col<64?halfDim-col:64;
                MulAddDst(r[col],z[halfDim+col],angle[trigOffset+col],mask,rows,broadcast);
                MulAddDst(r[halfDim+col],z[col],s[trigOffset+col],mask,rows,broadcast);
            }
            PipeBarrier<PIPE_ALL>();DataCopy(gd[fp32Offset+offset],r,count);PipeBarrier<PIPE_ALL>();
            rope1743::StoreFp32(output,r,count);
        }
        PipeBarrier<PIPE_ALL>();DataCopy(gy[offset],output,count);PipeBarrier<PIPE_ALL>();
    }
}

#define CHECK(expr) do {auto rc=(expr);if(rc!=ACL_SUCCESS){fprintf(stderr,"%s: %d\n",#expr,int(rc));return 2;}}while(0)
int main(int argc,char** argv) {
    if(argc<4){fprintf(stderr,"stage_probe INPUT_DIR DUMP_FLOATS OUTPUT_HALF [--device N]\n");return 1;}
    int device=0;for(int i=4;i+1<argc;++i)if(std::string(argv[i])=="--device")device=std::atoi(argv[++i]);
    constexpr uint32_t tokens=137,heads=17,dim=1024,tile=9,batch=9;constexpr float theta=10000.f;
    std::vector<half> x(uint64_t(tokens)*heads*dim);std::vector<int32_t> p(tokens);
    auto read=[](const std::string& path,void* dst,size_t bytes){std::ifstream f(path,std::ios::binary);f.read((char*)dst,bytes);return bool(f);};
    if(!read(std::string(argv[1])+"/x.bin",x.data(),x.size()*2)||!read(std::string(argv[1])+"/positions.bin",p.data(),p.size()*4))return 1;
    CHECK(aclInit(nullptr));CHECK(aclrtSetDevice(device));int64_t available;CHECK(aclrtGetDeviceInfo(device,ACL_DEV_ATTR_VECTOR_CORE_NUM,&available));
    uint32_t cores=std::min<uint64_t>(available,uint64_t(tokens)*((heads+tile-1)/tile));
    uint64_t floats=uint64_t(cores)*(dim/2)+5*uint64_t(tokens)*(dim/2)+3*x.size();
    std::vector<float> result(floats);std::vector<half> y(x.size());void *dx,*dp,*dr,*dy;
    CHECK(aclrtMalloc(&dx,x.size()*2,ACL_MEM_MALLOC_HUGE_FIRST));CHECK(aclrtMalloc(&dp,p.size()*4,ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK(aclrtMalloc(&dr,result.size()*4,ACL_MEM_MALLOC_HUGE_FIRST));CHECK(aclrtMalloc(&dy,y.size()*2,ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK(aclrtMemcpy(dx,x.size()*2,x.data(),x.size()*2,ACL_MEMCPY_HOST_TO_DEVICE));CHECK(aclrtMemcpy(dp,p.size()*4,p.data(),p.size()*4,ACL_MEMCPY_HOST_TO_DEVICE));
    aclrtStream stream;CHECK(aclrtCreateStream(&stream));
    uint64_t before=ropeActualKernelLaunches;
    stage_probe<<<cores,nullptr,stream>>>((GM_ADDR)dx,(GM_ADDR)dp,(GM_ADDR)dr,(GM_ADDR)dy,tokens,heads,dim,tile,batch,theta);
    CHECK(aclrtSynchronizeStreamWithTimeout(stream,30000));
    if(ropeActualKernelLaunches-before!=1){fprintf(stderr,"Expected one diagnostic kernel\n");return 3;}
    CHECK(aclrtMemcpy(result.data(),result.size()*4,dr,result.size()*4,ACL_MEMCPY_DEVICE_TO_HOST));CHECK(aclrtMemcpy(y.data(),y.size()*2,dy,y.size()*2,ACL_MEMCPY_DEVICE_TO_HOST));
    std::ofstream raw(argv[2],std::ios::binary);raw.write((char*)result.data(),result.size()*4);
    std::ofstream output(argv[3],std::ios::binary);output.write((char*)y.data(),y.size()*2);if(!raw||!output)return 1;
    printf("{\"device\":%d,\"soc\":\"%s\",\"cores\":%u,\"tokens\":%u,\"heads\":%u,\"dim\":%u,\"tile_heads\":%u,\"trig_batch\":%u,\"float_count\":%llu,\"device_kernel_launches\":1,\"diagnostic_only\":true}\n",device,aclrtGetSocName(),cores,tokens,heads,dim,tile,batch,(unsigned long long)floats);
    CHECK(aclrtFree(dx));CHECK(aclrtFree(dp));CHECK(aclrtFree(dr));CHECK(aclrtFree(dy));CHECK(aclrtDestroyStream(stream));CHECK(aclrtResetDevice(device));CHECK(aclFinalize());return 0;
}
