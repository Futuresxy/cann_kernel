+            PipeBarrier<PIPE_V>();
+            Gather(lo,c,index,0,pairs);Gather(hi,c,high,0,pairs);
+            PipeBarrier<PIPE_V>();
+            Mul(c,lo,z,pairs);Mul(s,hi,z,pairs);
+            // Preserve V4's four FP32 products and separate subtraction/addition.
+            // Only DMA/layout changes; no half intermediates or fused arithmetic.
+            PipeBarrier<PIPE_V>();Mul(z,hi,z[capacity_],pairs);
+            PipeBarrier<PIPE_V>();Sub(c,c,z,pairs);
+            PipeBarrier<PIPE_V>();Mul(z,lo,z[capacity_],pairs);
+            PipeBarrier<PIPE_V>();Add(s,s,z,pairs);
+            PipeBarrier<PIPE_V>();Gather(lo,c,packed,0,aligned);
+            PipeBarrier<PIPE_V>();auto output=out_.AllocTensor<T>();StoreFp32(output,lo,aligned);
+            out_.EnQue(output);output=out_.DeQue<T>();
+            DataCopyPad(y_[Offset(job)],output,{1,n*uint32_t(sizeof(T)),0,0,0});
+            in_.FreeTensor(input);out_.FreeTensor(output);
+        }
+        PipeBarrier<PIPE_ALL>();
+    }
+private:
+    TPipe pipe_;TQue<QuePosition::VECIN,2> in_;TQue<QuePosition::VECOUT,2> out_;
+    TBuf<TPosition::VECCALC> work_,index_,freq_,mask_;
+    GlobalTensor<T> x_,y_;GlobalTensor<int32_t> pos_;uint64_t tokens_;
+    uint32_t heads_,dim_,half_,pitch_,tile_,rows_,capacity_,groups_;
+};
