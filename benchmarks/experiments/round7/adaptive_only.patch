+// This computes the same FP32-rounded power as the protected path. Q31 error
+// after normalization is bounded by 32 units. Only results farther than this
+// bound from an FP32 halfway point are accepted; other values use Q53 below.
+// The table is generic exp2 range reduction generated in this invocation.
+__aicore__ inline bool TryFrequencyPowerQ31(int64_t log31,uint32_t numerator,uint32_t denominatorLog,
+    const LocalTensor<uint64_t>& table,uint64_t& mantissa,int32_t& exponent) {
+    int64_t x=(log31*int64_t(numerator))>>denominatorLog;
+    int64_t k=int64_t(RoundDivide(uint64_t(x<0?-x:x),uint64_t(1)<<26));if(x<0)k=-k;
+    int64_t r=x-k*int64_t(uint64_t(1)<<26);
+    int64_t p=int64_t(2147483648LL)+((r*(int64_t(1488522236LL)+
+        ((r*(int64_t(515886673LL)+((r*int64_t(119193107LL))>>31)))>>31)))>>31);
+    uint64_t center=RoundDivide(table.GetValue(uint32_t(k&31)),uint64_t(1)<<30);
+    uint64_t v=(center*uint64_t(p))>>31;exponent=int32_t(k>>5);
+    if(v<(uint64_t(1)<<31)){v<<=1;--exponent;}
+    else if(v>=(uint64_t(1)<<32)){v>>=1;++exponent;}
+    uint32_t remainder=uint32_t(v&255);
+    if(remainder>=96 && remainder<=160)return false;
+    mantissa=(v+128)>>8;return true;
+}
