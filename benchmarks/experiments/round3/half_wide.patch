+class HalfRotary {
+public:
+    template <typename F>
+    __aicore__ inline void Init(GM_ADDR x, GM_ADDR p, GM_ADDR y, uint64_t tokens,
+                               uint32_t heads, uint32_t dim, uint32_t tileHeads,
+                               const F& f) {
+        x_.SetGlobalBuffer((__gm__ half*)x); y_.SetGlobalBuffer((__gm__ half*)y);
+        pos_.SetGlobalBuffer((__gm__ int32_t*)p);
+        tokens_=tokens; heads_=heads; dim_=dim; half_=dim/2;
+        tileHeads_=tileHeads; groups_=(heads+tileHeads-1)/tileHeads;
+        freqSize_=(half_+7)/8*8;
+        size_=tileHeads*dim > freqSize_ ? tileHeads*dim : freqSize_;
+        pipe_.InitBuffer(in_,2,size_*sizeof(half));
+        pipe_.InitBuffer(out_,2,size_*sizeof(half));
+
+        batch_ = size_ / freqSize_;
+        if (batch_ > 16) batch_ = 16;
+        uint32_t baseBytes = 4*size_*sizeof(half);
+        uint32_t cacheCap = (188*1024 - baseBytes - freqSize_*sizeof(float)) /
+                            (26*freqSize_);
+        if (batch_ > cacheCap) batch_ = cacheCap;
+        if (batch_ < 1) batch_ = 1;
+        cacheSize_ = batch_ * freqSize_;
+        pipe_.InitBuffer(work_,2*cacheSize_*sizeof(float));
+        pipe_.InitBuffer(halfTrig_,3*cacheSize_*sizeof(half));
+        pipe_.InitBuffer(trig_,(freqSize_ + 3*cacheSize_)*sizeof(float));
+        auto freq=trig_.Get<float>();
+        FillFrequencies(freq,f,half_,freqSize_,work_.Get<float>());
+        PipeBarrier<PIPE_ALL>();
+    }
+    __aicore__ inline uint32_t Rows(uint64_t job) {
+        uint32_t n=heads_-(job%groups_)*tileHeads_;
+        return n<tileHeads_?n:tileHeads_;
+    }
+    __aicore__ inline uint64_t Offset(uint64_t job) {
+        return (job/groups_*heads_+(job%groups_)*tileHeads_)*dim_;
+    }
+    __aicore__ inline void Prefetch(uint64_t job) {
+        auto in=in_.AllocTensor<half>();
+        DataCopyPad(in,x_[Offset(job)],{1,Rows(job)*dim_*uint32_t(sizeof(half)),0,0,0},
+                    DataCopyPadExtParams<half>{false,0,0,0});
+        in_.EnQue(in);
+    }
+    __aicore__ inline uint32_t TrigBatch(uint64_t token,uint64_t tokenLimit) {
+        uint32_t count = tokenLimit-token < batch_ ? tokenLimit-token : batch_;
+        auto freq=trig_.Get<float>();auto c=freq[freqSize_];auto s=c[cacheSize_];
+        auto angle=s[cacheSize_];auto q=work_.Get<float>();auto temp=q[cacheSize_];
+        SetMaskCount();
+        SetVectorMask<float,MaskMode::COUNTER>(freqSize_);
+        for (uint32_t row=0;row<count;++row)
+            Muls<float,false>(angle[row*freqSize_],freq,static_cast<float>(pos_.GetValue(token+row)),
+                MASK_PLACEHOLDER,1,UnaryRepeatParams{1,1,8,8});
+        SetMaskNorm();ResetMask();
+        
+        SinCosFp32(angle,c,s,q,temp,count*freqSize_);
+        Muls(angle,s,-1.0f,count*freqSize_);
+        auto hc=halfTrig_.Get<half>();
+        Cast(hc,c,RoundMode::CAST_RINT,count*freqSize_);
+        Cast(hc[cacheSize_],s,RoundMode::CAST_RINT,count*freqSize_);
+        Cast(hc[2*cacheSize_],angle,RoundMode::CAST_RINT,count*freqSize_);
+        return count;
+    }
+    __aicore__ inline void Process() {
+        uint64_t jobs=tokens_*groups_;
+        uint64_t begin=jobs*GetBlockIdx()/GetBlockNum();
+        uint64_t end=jobs*(GetBlockIdx()+1)/GetBlockNum();
+        if(begin==end)return;
+        Prefetch(begin);
+        uint64_t cached=static_cast<uint64_t>(-1);
+        uint32_t cachedCount=0;
+
+        auto cosCache=halfTrig_.Get<half>();auto sinCache=cosCache[cacheSize_];
+        auto negCache=sinCache[cacheSize_];
+        uint8_t stride=dim_/16;
+        BinaryRepeatParams broadcast{1,1,1,stride,stride,0};
+        BinaryRepeatParams paired{1,1,1,stride,stride,stride};
+        for(uint64_t job=begin;job<end;++job) {
+            auto input=in_.DeQue<half>();
+            if(job+1<end)Prefetch(job+1);
+            uint64_t token=job/groups_;
+            int32_t position=pos_.GetValue(token);
+            uint32_t rows=Rows(job), count=rows*dim_;
+            auto output=out_.AllocTensor<half>();
+            if(position==0) {
+                DataCopy(output,input,count);
+            } else {
+                if(cached==static_cast<uint64_t>(-1) || token>=cached+cachedCount) {
+                    cachedCount=TrigBatch(token,(end-1)/groups_+1);
+                    cached=token;
+                }
+                uint32_t trigOffset=(token-cached)*freqSize_;
+                auto c=cosCache[trigOffset];auto s=sinCache[trigOffset];auto negs=negCache[trigOffset];
+                auto z=input;auto r=output;
+                
+                for(uint32_t col=0;col<half_;col+=128) {
+                    uint64_t mask=half_-col<128?half_-col:128;
+                    SetVectorMask<half>(mask);
+                    Mul<half,false>(r[col],z[col],c[col],MASK_PLACEHOLDER,rows,broadcast);
+                    Mul<half,false>(r[half_+col],z[half_+col],c[col],MASK_PLACEHOLDER,rows,broadcast);
+                    MulAddDst<half,half,false>(r[col],z[half_+col],negs[col],MASK_PLACEHOLDER,rows,broadcast);
+                    MulAddDst<half,half,false>(r[half_+col],z[col],s[col],MASK_PLACEHOLDER,rows,broadcast);
+                }
+                ResetMask();
+
+            }
+            out_.EnQue(output);output=out_.DeQue<half>();
+            DataCopyPad(y_[Offset(job)],output,{1,count*uint32_t(sizeof(half)),0,0,0});
+            in_.FreeTensor(input);out_.FreeTensor(output);
+        }
+        PipeBarrier<PIPE_ALL>();
+    }
+private:
+    TPipe pipe_;
+    TQue<QuePosition::VECIN,2> in_;
+    TQue<QuePosition::VECOUT,2> out_;
+    TBuf<TPosition::VECCALC> work_,trig_,halfTrig_;
+    GlobalTensor<half> x_,y_;
+    GlobalTensor<int32_t> pos_;
+    uint64_t tokens_;
+    uint32_t heads_,dim_,half_,tileHeads_,groups_,size_,freqSize_,batch_,cacheSize_;
+};
+__global__ __vector__ void half_fast_kernel(GM_ADDR x,GM_ADDR p,GM_ADDR y,uint64_t tokens,
+    uint32_t heads,uint32_t dim,uint32_t tile,Frequencies f) {
+    HalfRotary op;op.Init(x,p,y,tokens,heads,dim,tile,f);op.Process();
+}
+
