+template <typename T> class HeadTileRotary {
+public:
+    __aicore__ inline void Init(GM_ADDR x,GM_ADDR p,GM_ADDR y,uint64_t tokens,
+        uint32_t heads,uint32_t dim,uint32_t tileTokens,const Frequencies& f) {
+        x_.SetGlobalBuffer((__gm__ T*)x);pos_.SetGlobalBuffer((__gm__ int32_t*)p);
+        y_.SetGlobalBuffer((__gm__ T*)y);
+        tokens_=tokens;heads_=heads;dim_=dim;half_=dim/2;pitch_=(half_+15)/16*16;
+        tile_=tileTokens;rows_=tile_;groups_=(heads_+tile_-1)/tile_;capacity_=rows_*pitch_;
