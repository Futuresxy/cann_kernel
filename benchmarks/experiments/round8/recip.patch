+// Exact division of 2^47 by a normalized FP32 significand. Each
+// remainder fits 24 bits; appending eight bits stays within uint32_t.
+__aicore__ inline uint64_t ReciprocalSignificand(uint32_t m) {
+    uint32_t n=uint32_t(1)<<31,q=n/m,r=n-q*m;
+    n=r<<8;uint32_t a=n/m;r=n-a*m;
+    n=r<<8;uint32_t b=n/m;r=n-b*m;
+    q=(q<<16)|(a<<8)|b;
+    return q+uint32_t(r>m-r || (r==m-r && (q&1)));
+}
