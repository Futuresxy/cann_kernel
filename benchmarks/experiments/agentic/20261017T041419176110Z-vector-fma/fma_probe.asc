// Development-only rounding probe. Never included in the competition payload.
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <fstream>
#include <vector>
#include "acl/acl.h"
#include "kernel_operator.h"
using namespace AscendC;
__global__ __vector__ void fma_probe_kernel(GM_ADDR input, GM_ADDR output, uint32_t count) {
    TPipe pipe;
    TBuf<TPosition::VECCALC> buf;
    constexpr uint32_t tile=1024;
    pipe.InitBuffer(buf,13*tile*sizeof(float));
    auto work=buf.Get<float>();
    auto a=work[0*tile],b=work[1*tile],p=work[2*tile],neg=work[3*tile];
    auto f=work[4*tile],m=work[5*tile],sp=work[6*tile],sn=work[7*tile],sf=work[8*tile];
    auto c=work[9*tile],generalF=work[10*tile],generalM=work[11*tile],separate=work[12*tile];
    GlobalTensor<float> in,out;in.SetGlobalBuffer((__gm__ float*)input);out.SetGlobalBuffer((__gm__ float*)output);
    for(uint32_t offset=0;offset<count;offset+=tile) {
        uint32_t n=count-offset<tile?count-offset:tile;
        DataCopy(a,in[offset],n);DataCopy(b,in[count+offset],n);
        DataCopy(c,in[2*count+offset],n);
        PipeBarrier<PIPE_ALL>();
        Mul(p,a,b,n);Muls(neg,p,-1.0f,n);
        Mul(sp,a,a,n);Muls(sn,sp,-1.0f,n);
        PipeBarrier<PIPE_V>();
        DataCopy(f,a,n);DataCopy(m,neg,n);DataCopy(sf,a,n);
        DataCopy(generalF,a,n);DataCopy(generalM,c,n);
        PipeBarrier<PIPE_V>();
        FusedMulAdd(f,b,neg,n); // dst = a * b - round(a*b)
        MulAddDst(m,a,b,n);    // dst = -round(a*b) + a * b
        FusedMulAdd(sf,sf,sn,n); // full dst/src0 alias, square residual
        FusedMulAdd(generalF,b,c,n);
        MulAddDst(generalM,a,b,n);
        Add(separate,p,c,n);
        PipeBarrier<PIPE_ALL>();
        DataCopy(out[0*count+offset],p,n);DataCopy(out[1*count+offset],f,n);
        DataCopy(out[2*count+offset],m,n);DataCopy(out[3*count+offset],sp,n);
        DataCopy(out[4*count+offset],sf,n);
        DataCopy(out[5*count+offset],generalF,n);DataCopy(out[6*count+offset],generalM,n);
        DataCopy(out[7*count+offset],separate,n);
        PipeBarrier<PIPE_ALL>();
    }
}
#define CHECK(x) do {auto rc=(x);if(rc!=ACL_SUCCESS){fprintf(stderr,"%s: %d\n",#x,int(rc));return 2;}}while(0)
int main(int argc,char** argv) {
    if(argc<4)return 1;
    const char *input=argv[1],*output=argv[2];uint32_t n=std::strtoul(argv[3],nullptr,10);int device=0;
    for(int i=4;i+1<argc;++i)if(std::string(argv[i])=="--device")device=std::atoi(argv[++i]);
    if(!n||n%64)return 1;
    std::vector<float> x(3*n),y(8*n);
    std::ifstream file(input,std::ios::binary);file.read((char*)x.data(),x.size()*4);if(!file)return 1;
    CHECK(aclInit(nullptr));CHECK(aclrtSetDevice(device));aclrtStream stream;CHECK(aclrtCreateStream(&stream));
    void *dx,*dy;CHECK(aclrtMalloc(&dx,x.size()*4,ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK(aclrtMalloc(&dy,y.size()*4,ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK(aclrtMemcpy(dx,x.size()*4,x.data(),x.size()*4,ACL_MEMCPY_HOST_TO_DEVICE));
    fma_probe_kernel<<<1,nullptr,stream>>>((GM_ADDR)dx,(GM_ADDR)dy,n);
    CHECK(aclrtSynchronizeStreamWithTimeout(stream,30000));
    CHECK(aclrtMemcpy(y.data(),y.size()*4,dy,y.size()*4,ACL_MEMCPY_DEVICE_TO_HOST));
    std::ofstream out(output,std::ios::binary);out.write((char*)y.data(),y.size()*4);if(!out)return 1;
    printf("soc=%s device=%d count=%u device_kernels=1\n",aclrtGetSocName(),device,n);
    CHECK(aclrtFree(dx));CHECK(aclrtFree(dy));CHECK(aclrtDestroyStream(stream));
    CHECK(aclrtResetDevice(device));CHECK(aclFinalize());return 0;
}
