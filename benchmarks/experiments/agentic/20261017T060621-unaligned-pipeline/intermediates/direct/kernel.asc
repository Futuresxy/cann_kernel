                    uint32_t n=i<<(23+shift),q=n/width,r=n-q*width;
                    mant=q+uint32_t(r>width-r || (r==width-r && (q&1)));
                } else mant=RoundDivide(uint64_t(i)<<(23+shift),width);
                numerator=uint32_t(mant);denominatorLog=23+shift;
                exponent=int64_t(mant<<(30-shift));
            }
            uint64_t pm=0;int32_t e=0;
            if(!TryExp2PowerQ31(log31,numerator,denominatorLog,pm,e)) {
            int64_t x=SignedMultiplyQ53(log,exponent);
            int64_t ki=int64_t(RoundDivide(uint64_t(x<0?-x:x),uint64_t(1)<<48));
            if(x<0)ki=-ki;
            if((ki&31)!=0 && !rootsReady){BuildExp2Roots(table);rootsReady=true;}
            int64_t r=x-ki*int64_t(uint64_t(1)<<48);
            int64_t p=int64_t(9007199254740992LL)+SignedMultiplyQ53(r,
                int64_t(6243314769351382LL)+SignedMultiplyQ53(r,
                int64_t(2163785536024893LL)+SignedMultiplyQ53(r,int64_t(499932125008441LL))));
            uint64_t center=RoundDivide(Exp2Center(table,uint32_t(ki&31)),256);
            uint64_t power=MultiplyQ53(center,uint64_t(p));e=int32_t(ki>>5);
            if(power<(uint64_t(1)<<53)){power<<=1;--e;}
            else if(power>=(uint64_t(1)<<54)){power>>=1;++e;}
            pm=RoundDivide(power,uint64_t(1)<<30);
            }
            if(pm>=(uint64_t(1)<<24)){pm>>=1;++e;}
            // Reuse an identical rounded power only inside this call.
            // Every exponent and power is still computed from current theta.
            uint64_t powerKey=(uint64_t(uint32_t(e))<<24)|pm;
            if(powerKey==previousPower)result=previousResult;
            else {
            int32_t fe;uint64_t fm;
            if(pm==(uint64_t(1)<<23)){fe=-e;fm=uint64_t(1)<<23;}
            else {fe=-e-1;fm=RoundDivide(uint64_t(1)<<47,pm);}
            if(fm>=(uint64_t(1)<<24)){fm>>=1;++fe;}
            result=(uint32_t(fe+127)<<23)|uint32_t(fm-(uint64_t(1)<<23));
                previousPower=powerKey;previousResult=result;
            }
        }
        FloatBits f;f.bits=result;dst.SetValue(i,f.value);
    }
    for(uint32_t i=width;i<pitch;++i)dst.SetValue(i,0.0f);
    PipeBarrier<PIPE_ALL>();
}

// Generate the generic exp2 table on the scalar pipe with guard bits.
__aicore__ inline void DeviceExp2Table(const LocalTensor<float>& table,const LocalTensor<float>& scratch,uint32_t stride) {
    uint64_t term=uint64_t(1)<<61,total=term;
    uint64_t step=uint64_t(1598288580650331957ULL)>>5;
    term=MultiplyQ61(term,step)/1u;total+=term;
    term=MultiplyQ61(term,step)/2u;total+=term;
    term=MultiplyQ61(term,step)/3u;total+=term;
    term=MultiplyQ61(term,step)/4u;total+=term;
    term=MultiplyQ61(term,step)/5u;total+=term;
    term=MultiplyQ61(term,step)/6u;total+=term;
    term=MultiplyQ61(term,step)/7u;total+=term;
    term=MultiplyQ61(term,step)/8u;total+=term;
    term=MultiplyQ61(term,step)/9u;total+=term;
    uint64_t v=uint64_t(1)<<61;
    for(uint32_t j=0;j<32;++j) {
        float hi=static_cast<float>(int32_t(v>>38))*0x1p-23f;
        uint64_t rem=v&((uint64_t(1)<<38)-1);
        float lo=static_cast<float>(int32_t(rem>>15))*0x1p-46f+
            static_cast<float>(int32_t(rem&32767))*0x1p-61f;
        table.SetValue(j,hi);table.SetValue(j+32,lo);v=MultiplyQ61(v,total);
    }
    PipeBarrier<PIPE_ALL>();
}

// Near log(theta)=0, power values can lie closer to an FP32 halfway
// point than the double-float vector approximation can resolve. Use the
// integer guard-bit algorithm for this numerical conditioning window.
__aicore__ inline bool ScalarFrequencyMode(uint32_t width,float theta) {
    bool nearUnity=theta!=1.0f && theta>=1.0f-0x1p-20f && theta<=1.0f+0x1p-20f;
    return (width<=32 || nearUnity) && theta>=0x1p-64f && theta<=0x1p64f;
}

__aicore__ inline void FillFrequencies(const LocalTensor<float>& dst,const Frequencies& f,
    uint32_t width,uint32_t pitch,const LocalTensor<float>& scratch) {
    FloatBits bits;bits.value=f.theta;
    int32_t exponent=int32_t((bits.bits>>23)&255)-127;
    if(exponent==-127){bits.value=f.theta*8388608.0f;exponent=int32_t((bits.bits>>23)&255)-127-23;}
    bits.bits=(bits.bits&0x007fffffu)|0x3f800000u;
    float mantissa=bits.value;
    if(mantissa>1.4142135623730951f){mantissa*=0.5f;++exponent;}
    float logHi,logLo;DeviceLogTheta(mantissa,exponent,scratch,logHi,logLo);
    uint32_t stride=(scratch.GetSize()-64)/FREQUENCY_MATH_SLOTS;
    stride=stride/8*8;if(stride>pitch)stride=pitch;
    if(stride<32)stride=32;if(stride>512)stride=512;
    auto table=scratch[17*stride];
    DeviceExp2Table(table,scratch,stride);
    int32_t shift=f.theta<1.0f?64:-64;float finish=f.theta<1.0f?0x1p-64f:0x1p64f;
    for(uint32_t start=0;start<pitch;start+=stride){
        uint32_t count=pitch-start<stride?pitch-start:stride;
        DeviceFrequencyChunk(dst[start],table,scratch,start,width,count,stride,logHi,logLo,shift,finish);
    }
    for(uint32_t i=width;i<pitch;++i)dst.SetValue(i,0.0f);
    PipeBarrier<PIPE_ALL>();
}

__aicore__ inline void FillDeviceFrequencies(TPipe& pipe,TBuf<TPosition::VECCALC>& fallback,
    const LocalTensor<float>& dst,const ScalarFrequencyConfig& f,uint32_t width,uint32_t pitch,const LocalTensor<float>& scratch) {
    if(scratch.GetSize()>=16)ScalarFrequencies(dst,f.theta,width,pitch,scratch);
    else {pipe.InitBuffer(fallback,64);ScalarFrequencies(dst,f.theta,width,pitch,fallback.Get<float>());}
}
__aicore__ inline void FillDeviceFrequencies(TPipe& pipe,TBuf<TPosition::VECCALC>& fallback,
    const LocalTensor<float>& dst,const Frequencies& f,uint32_t width,uint32_t pitch,const LocalTensor<float>& scratch) {
    uint32_t full=FREQUENCY_MATH_SLOTS*(pitch<32?32:pitch)+64;
    // In these kernels, a reusable region <=24 KiB implies less than 140 KiB
    // of live UB. Even a full 512-lane math region keeps the total below 192 KiB.
    if(scratch.GetSize()>=full || scratch.GetSize()>6144)
        FillFrequencies(dst,f,width,pitch,scratch);
    else {pipe.InitBuffer(fallback,full*sizeof(float));FillFrequencies(dst,f,width,pitch,fallback.Get<float>());}
}

// C++14 overloads keep datatype dispatch inside this file. The original
// CMakeLists.txt and the competition harness need no language-mode changes.
__aicore__ inline void LoadFp32(const LocalTensor<float>& dst,
    const LocalTensor<float>& src, uint32_t count) {
    DataCopy(dst, src, count);
}
__aicore__ inline void LoadFp32(const LocalTensor<float>& dst,
    const LocalTensor<half>& src, uint32_t count) {
    Cast(dst, src, RoundMode::CAST_NONE, count);
}
__aicore__ inline void StoreFp32(const LocalTensor<float>& dst,
    const LocalTensor<float>& src, uint32_t count) {
    DataCopy(dst, src, count);
}
__aicore__ inline void StoreFp32(const LocalTensor<half>& dst,
    const LocalTensor<float>& src, uint32_t count) {
    Cast(dst, src, RoundMode::CAST_RINT, count);
}

// Joint FP32 sine/cosine. Split range reduction is exact in its large terms
// over the supported position range. The polynomial sees only [-pi/4,pi/4].
__aicore__ inline void SinCosFp32(const LocalTensor<float>& angle,
    const LocalTensor<float>& c,const LocalTensor<float>& s,
    const LocalTensor<float>& q,const LocalTensor<float>& temp,uint32_t n) {
    Muls(q,angle,0.15915494309189535f,n);
    Cast(temp.ReinterpretCast<int32_t>(),q,RoundMode::CAST_RINT,n);
    Cast(q,temp.ReinterpretCast<int32_t>(),RoundMode::CAST_NONE,n);
    Muls(temp,q,6.25f,n);Sub(angle,angle,temp,n);
    Muls(temp,q,0.033203125f,n);Sub(angle,angle,temp,n);
    Muls(temp,q,-0.000017817820413523074f,n);Sub(angle,angle,temp,n);
    Muls(angle,angle,0.25f,n);
    Mul(q,angle,angle,n);
    Muls(s,q,1.0f/362880.0f,n);
    Adds(s,s,-1.0f/5040.0f,n);
    Mul(s,s,q,n);Adds(s,s,1.0f/120.0f,n);
    Mul(s,s,q,n);Adds(s,s,-1.0f/6.0f,n);
    Mul(s,s,q,n);Adds(s,s,1.0f,n);
    Mul(s,s,angle,n);
    Mul(c,s,s,n);Muls(c,c,-1.0f,n);
    Adds(c,c,1.0f,n);Sqrt(c,c,n);
    Mul(angle,s,c,n);Muls(angle,angle,2.0f,n);
    Mul(s,s,s,n);Muls(s,s,-2.0f,n);
    Adds(s,s,1.0f,n);
    Mul(c,angle,angle,n);Muls(c,c,-2.0f,n);
    Adds(c,c,1.0f,n);
    Mul(s,angle,s,n);Muls(s,s,2.0f,n);
}


__aicore__ inline void ScalarFrequencyRange(const LocalTensor<float>& dst,float theta,
    uint32_t width,uint32_t start,uint32_t count,uint32_t pitch,const LocalTensor<float>& scratch) {
    int64_t log=DeviceLog2Q53(theta),log31=log/int64_t(4194304LL);
    bool binaryWidth=(width&(width-1))==0;uint32_t widthLog=0;
    if(binaryWidth){uint32_t n=width;while(n>1){n>>=1;++widthLog;}}
    auto table=scratch.ReinterpretCast<uint64_t>();
    bool rootsReady=false;
    uint64_t previousPower=~uint64_t(0);uint32_t previousResult=0;
    for(uint32_t col=0;col<count;++col) {
        uint32_t i=start+col;
        uint32_t result=0x3f800000u;
        if(i!=0) {
            uint32_t numerator=i,denominatorLog=widthLog;
            int64_t exponent;
            if(binaryWidth)exponent=int64_t(uint64_t(i)<<(53-widthLog));
            else {
                uint32_t shift=0;while((i<<shift)<width)++shift;
                uint64_t mant;
                if(width<=128) {
                    uint32_t n=i<<(23+shift),q=n/width,r=n-q*width;
                    mant=q+uint32_t(r>width-r || (r==width-r && (q&1)));
                } else mant=RoundDivide(uint64_t(i)<<(23+shift),width);
                numerator=uint32_t(mant);denominatorLog=23+shift;
                exponent=int64_t(mant<<(30-shift));
            }
            uint64_t pm=0;int32_t e=0;
            if(!TryExp2PowerQ31(log31,numerator,denominatorLog,pm,e)) {
            int64_t x=SignedMultiplyQ53(log,exponent);
            int64_t ki=int64_t(RoundDivide(uint64_t(x<0?-x:x),uint64_t(1)<<48));
            if(x<0)ki=-ki;
            if((ki&31)!=0 && !rootsReady){BuildExp2Roots(table);rootsReady=true;}
            int64_t r=x-ki*int64_t(uint64_t(1)<<48);
            int64_t p=int64_t(9007199254740992LL)+SignedMultiplyQ53(r,
                int64_t(6243314769351382LL)+SignedMultiplyQ53(r,
                int64_t(2163785536024893LL)+SignedMultiplyQ53(r,int64_t(499932125008441LL))));
            uint64_t center=RoundDivide(Exp2Center(table,uint32_t(ki&31)),256);
            uint64_t power=MultiplyQ53(center,uint64_t(p));e=int32_t(ki>>5);
            if(power<(uint64_t(1)<<53)){power<<=1;--e;}
            else if(power>=(uint64_t(1)<<54)){power>>=1;++e;}
            pm=RoundDivide(power,uint64_t(1)<<30);
            }
            if(pm>=(uint64_t(1)<<24)){pm>>=1;++e;}
            // Reuse an identical rounded power only inside this call.
            // Every exponent and power is still computed from current theta.
            uint64_t powerKey=(uint64_t(uint32_t(e))<<24)|pm;
            if(powerKey==previousPower)result=previousResult;
            else {
            int32_t fe;uint64_t fm;
            if(pm==(uint64_t(1)<<23)){fe=-e;fm=uint64_t(1)<<23;}
            else {fe=-e-1;fm=RoundDivide(uint64_t(1)<<47,pm);}
            if(fm>=(uint64_t(1)<<24)){fm>>=1;++fe;}
            result=(uint32_t(fe+127)<<23)|uint32_t(fm-(uint64_t(1)<<23));
                previousPower=powerKey;previousResult=result;
            }
        }
        FloatBits f;f.bits=result;dst.SetValue(col,f.value);
    }
    for(uint32_t i=count;i<pitch;++i)dst.SetValue(i,0.0f);
    PipeBarrier<PIPE_ALL>();
}

// Small working sets distribute independent frequency columns over AIV cores.
// Each core owns complete paired columns; every output is written once.
template <typename T> class SmallRotary {
public:
    __aicore__ inline void Init(GM_ADDR x,GM_ADDR p,GM_ADDR y,uint64_t tokens,
        uint32_t heads,uint32_t dim,uint32_t tileHeads,uint32_t splits,float theta) {
        x_.SetGlobalBuffer((__gm__ T*)x);y_.SetGlobalBuffer((__gm__ T*)y);
        pos_.SetGlobalBuffer((__gm__ int32_t*)p);
        tokens_=tokens;heads_=heads;dim_=dim;half_=dim/2;tile_=tileHeads;splits_=splits;
        uint32_t quantum=32/sizeof(T);
        uint32_t part=((half_+splits-1)/splits+quantum-1)/quantum*quantum;
        start_=(GetBlockIdx()%splits)*part;
        width_=half_-start_<part?half_-start_:part;
        pitch_=(width_+quantum-1)/quantum*quantum;capacity_=tile_*pitch_;
        groups_=(heads_+tile_-1)/tile_;
        pipe_.InitBuffer(in_,1,2*capacity_*sizeof(T));
        pipe_.InitBuffer(out_,1,2*capacity_*sizeof(T));
        uint32_t workCount=5*capacity_;if(workCount<16)workCount=16;
        pipe_.InitBuffer(work_,workCount*sizeof(float));
        pipe_.InitBuffer(trig_,4*pitch_*sizeof(float));
        ScalarFrequencyRange(trig_.Get<float>(),theta,half_,start_,width_,pitch_,work_.Get<float>());
    }
    __aicore__ inline void Process() {
        uint64_t jobs=tokens_*groups_;
        uint32_t block=GetBlockIdx()/splits_,blocks=GetBlockNum()/splits_;
        uint64_t first=jobs*block/blocks,last=jobs*(block+1)/blocks;
        auto a=work_.Get<float>();auto b=a[capacity_];auto r1=b[capacity_];
        auto r2=r1[capacity_];auto tmp=r2[capacity_];
        auto freq=trig_.Get<float>();auto angle=freq[pitch_];auto c=angle[pitch_];auto s=c[pitch_];
        uint64_t cached=static_cast<uint64_t>(-1);
        uint8_t stride=pitch_/8;
        BinaryRepeatParams broadcast{1,1,1,stride,stride,0};
        BinaryRepeatParams paired{1,1,1,stride,stride,stride};
        uint32_t localGap=(pitch_*sizeof(T)-(width_*sizeof(T)+31)/32*32)/32;
        for(uint64_t job=first;job<last;++job) {
            uint64_t token=job/groups_;uint32_t head=(job%groups_)*tile_;
            uint32_t rows=heads_-head;if(rows>tile_)rows=tile_;
            uint32_t count=rows*pitch_;uint64_t offset=(token*heads_+head)*dim_+start_;
            auto in=in_.AllocTensor<T>();
            DataCopyExtParams load{static_cast<uint16_t>(rows),width_*uint32_t(sizeof(T)),
                (dim_-width_)*uint32_t(sizeof(T)),localGap,0};
            DataCopyPad(in,x_[offset],load,DataCopyPadExtParams<T>{true,0,static_cast<uint8_t>(pitch_-width_),0});
            DataCopyPad(in[capacity_],x_[offset+half_],load,DataCopyPadExtParams<T>{true,0,static_cast<uint8_t>(pitch_-width_),0});
            in_.EnQue(in);in=in_.DeQue<T>();
            int32_t p=pos_.GetValue(token);
            auto out=out_.AllocTensor<T>();
            if(p==0) {DataCopy(out,in,count);DataCopy(out[capacity_],in[capacity_],count);}
            else {
                if(token!=cached) {
                    Muls(angle,freq,static_cast<float>(p),width_);
                    SinCosFp32(angle,c,s,a,b,width_);cached=token;
                }
                LoadFp32(a,in,count);LoadFp32(b,in[capacity_],count);
                Duplicate(r1,0.0f,count);Duplicate(r2,0.0f,count);
                for(uint32_t col=0;col<width_;col+=64) {
                    uint64_t mask=width_-col<64?width_-col:64;
                    Mul(r1[col],a[col],c[col],mask,rows,broadcast);
                    Mul(tmp[col],b[col],s[col],mask,rows,broadcast);
                    Sub(r1[col],r1[col],tmp[col],mask,rows,paired);
                    Mul(r2[col],b[col],c[col],mask,rows,broadcast);
                    Mul(tmp[col],a[col],s[col],mask,rows,broadcast);
                    Add(r2[col],r2[col],tmp[col],mask,rows,paired);
                }
                StoreFp32(out,r1,count);StoreFp32(out[capacity_],r2,count);
            }
            out_.EnQue(out);out=out_.DeQue<T>();
            DataCopyExtParams store{static_cast<uint16_t>(rows),width_*uint32_t(sizeof(T)),
                localGap,(dim_-width_)*uint32_t(sizeof(T)),0};
            DataCopyPad(y_[offset],out,store);DataCopyPad(y_[offset+half_],out[capacity_],store);
            PipeBarrier<PIPE_ALL>();in_.FreeTensor(in);out_.FreeTensor(out);
        }
    }
private:
    TPipe pipe_;TQue<QuePosition::VECIN,1> in_;TQue<QuePosition::VECOUT,1> out_;
    TBuf<TPosition::VECCALC> work_,trig_;GlobalTensor<T> x_,y_;GlobalTensor<int32_t> pos_;
    uint64_t tokens_;uint32_t heads_,dim_,half_,tile_,splits_,start_,width_,pitch_,capacity_,groups_;
};
template <typename T>
__global__ __vector__ void small_kernel(GM_ADDR x,GM_ADDR p,GM_ADDR y,uint64_t tokens,
    uint32_t heads,uint32_t dim,uint32_t tile,uint32_t splits,float theta) {
    SmallRotary<T> op;op.Init(x,p,y,tokens,heads,dim,tile,splits,theta);op.Process();
}

template <typename T> class Rotary {
public:
    template <typename F>
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR pos, GM_ADDR y, uint64_t tokens,
                               uint32_t heads, uint32_t dim, uint32_t colStart, uint32_t width, uint32_t tileHeads,
                               const F& frequencies) {
        x_.SetGlobalBuffer((__gm__ T*)x);
        y_.SetGlobalBuffer((__gm__ T*)y);
        pos_.SetGlobalBuffer((__gm__ int32_t*)pos);
        tokens_ = tokens; heads_ = heads; dim_ = dim; half_ = dim / 2;
        colStart_ = colStart; width_ = width;
        pitch_ = (width_ + 15) / 16 * 16;
        tileHeads_ = tileHeads;
        groups_ = (heads + tileHeads - 1) / tileHeads;
        capacity_ = tileHeads * pitch_;
        pipe_.InitBuffer(in_, 1, 2 * capacity_ * sizeof(T));
        pipe_.InitBuffer(out_, 1, 2 * capacity_ * sizeof(T));
        pipe_.InitBuffer(work_, 5 * capacity_ * sizeof(float));
        pipe_.InitBuffer(freq_, (width_>256?512:pitch_) * sizeof(float));
        auto f = freq_.Get<float>();
        FillDeviceFrequencies(pipe_,frequencyMath_,f,frequencies,width_,pitch_,work_.Get<float>());
    }

    __aicore__ inline void Process() {
        auto a = work_.Get<float>();
        auto b = a[capacity_];
        auto c = a[2 * capacity_];
        auto s = a[3 * capacity_];
        auto tmp = a[4 * capacity_];
        uint64_t jobs = tokens_ * groups_;
        // Contiguous partitions retain token-local cos/sin when a token spans tiles.
        uint64_t begin = jobs * GetBlockIdx() / GetBlockNum();
        uint64_t end = jobs * (GetBlockIdx() + 1) / GetBlockNum();
        uint64_t lastToken = static_cast<uint64_t>(-1);
        for (uint64_t job = begin; job < end; ++job) {
            uint64_t token = job / groups_;
            uint32_t firstHead = (job % groups_) * tileHeads_;
            uint32_t rows = heads_ - firstHead;
            if (rows > tileHeads_) rows = tileHeads_;
            uint32_t count = rows * pitch_;
            uint64_t offset = (token * heads_ + firstHead) * dim_ + colStart_;
            int32_t position = pos_.GetValue(token);
            auto in = in_.AllocTensor<T>();
            uint32_t localGap = (pitch_ * sizeof(T) - ((width_ * sizeof(T) + 31) / 32 * 32)) / 32;
            DataCopyExtParams load{static_cast<uint16_t>(rows), width_ * uint32_t(sizeof(T)),
                                   (dim_ - width_) * uint32_t(sizeof(T)), localGap, 0};
            DataCopyPad(in, x_[offset], load, DataCopyPadExtParams<T>{false, 0, 0, 0});
            DataCopyPad(in[capacity_], x_[offset + half_], load,
                        DataCopyPadExtParams<T>{false, 0, 0, 0});
            in_.EnQue(in); in = in_.DeQue<T>();
            if (position == 0) {
                PipeBarrier<PIPE_ALL>();
                DataCopyExtParams store{static_cast<uint16_t>(rows), width_ * uint32_t(sizeof(T)),
                                        localGap, (dim_ - width_) * uint32_t(sizeof(T)), 0};
                DataCopyPad(y_[offset], in, store);
                DataCopyPad(y_[offset + half_], in[capacity_], store);
                PipeBarrier<PIPE_ALL>();
                in_.FreeTensor(in);
                continue;
            }
            if (token != lastToken) {
                // FP32 angles match the supplied reference's rounding. A split 2*pi
                // reduction also covers positions above the Sin/Cos API's input range.
                Muls(a, freq_.Get<float>(), static_cast<float>(position), pitch_);
                
                SinCosFp32(a,c,s,tmp,b,pitch_);
                for (uint32_t h = 1; h < tileHeads_; ++h) {
                    DataCopy(c[h * pitch_], c, pitch_);
                    DataCopy(s[h * pitch_], s, pitch_);
                }
                
                lastToken = token;
            }
            LoadFp32(a, in, count);
            LoadFp32(b, in[capacity_], count);
            
            auto out = out_.AllocTensor<T>();
            Mul(tmp, b, s, count); 
            Mul(a, a, c, count); 
            Sub(a, a, tmp, count); 
            // Recover the original first half for y2; the input is still resident.
            LoadFp32(tmp, in, count);
            
            Mul(tmp, tmp, s, count); 
            Mul(b, b, c, count); 
            Add(b, b, tmp, count); 
            StoreFp32(out, a, count);
            StoreFp32(out[capacity_], b, count);
            out_.EnQue(out); out = out_.DeQue<T>();
            DataCopyExtParams store{static_cast<uint16_t>(rows), width_ * uint32_t(sizeof(T)),
                                    localGap, (dim_ - width_) * uint32_t(sizeof(T)), 0};
            DataCopyPad(y_[offset], out, store);
            DataCopyPad(y_[offset + half_], out[capacity_], store);
            PipeBarrier<PIPE_ALL>();
            in_.FreeTensor(in); out_.FreeTensor(out);
        }
    }
private:
    TPipe pipe_; TBuf<TPosition::VECCALC> frequencyMath_;
    TQue<QuePosition::VECIN, 1> in_;
    TQue<QuePosition::VECOUT, 1> out_;
    TBuf<TPosition::VECCALC> work_, freq_;
    GlobalTensor<T> x_, y_;
    GlobalTensor<int32_t> pos_;
    uint64_t tokens_;
    uint32_t heads_, dim_, half_, colStart_, width_, pitch_, tileHeads_, groups_, capacity_;
};

// FP32 keeps the two original halves in VECIN and computes directly into
// VECOUT. Dense coefficients preserve the generic count-API arithmetic.
template <> class Rotary<float> {
public:
    template <typename F>
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR pos, GM_ADDR y, uint64_t tokens,
        uint32_t heads, uint32_t dim, uint32_t colStart, uint32_t width,
        uint32_t tileHeads, const F& frequencies) {
        x_.SetGlobalBuffer((__gm__ float*)x);
        y_.SetGlobalBuffer((__gm__ float*)y);
        pos_.SetGlobalBuffer((__gm__ int32_t*)pos);
        tokens_=tokens; heads_=heads; dim_=dim; half_=dim/2;
        colStart_=colStart; width_=width; pitch_=(width+15)/16*16;
        tileHeads_=tileHeads; groups_=(heads+tileHeads-1)/tileHeads;
        capacity_=tileHeads*pitch_;
        pipe_.InitBuffer(in_,1,2*capacity_*sizeof(float));
        pipe_.InitBuffer(out_,1,2*capacity_*sizeof(float));
        pipe_.InitBuffer(work_,3*capacity_*sizeof(float));
        pipe_.InitBuffer(freq_,(width_>256?512:pitch_)*sizeof(float));
        FillDeviceFrequencies(pipe_,frequencyMath_,freq_.Get<float>(),frequencies,
                              width_,pitch_,work_.Get<float>());
    }
    __aicore__ inline void Process() {
        auto c=work_.Get<float>(); auto s=c[capacity_]; auto tmp=c[2*capacity_];
        uint64_t jobs=tokens_*groups_;
        uint64_t begin=jobs*GetBlockIdx()/GetBlockNum();
        uint64_t end=jobs*(GetBlockIdx()+1)/GetBlockNum();
        uint64_t lastToken=static_cast<uint64_t>(-1);
        for(uint64_t job=begin;job<end;++job) {
            uint64_t token=job/groups_;
            uint32_t firstHead=(job%groups_)*tileHeads_;
            uint32_t rows=heads_-firstHead; if(rows>tileHeads_)rows=tileHeads_;
            uint32_t count=rows*pitch_;
            uint64_t offset=(token*heads_+firstHead)*dim_+colStart_;
            uint32_t localGap=(pitch_*sizeof(float)-((width_*sizeof(float)+31)/32*32))/32;
            auto input=in_.AllocTensor<float>();
            DataCopyExtParams load{static_cast<uint16_t>(rows),width_*uint32_t(sizeof(float)),
                (dim_-width_)*uint32_t(sizeof(float)),localGap,0};
            DataCopyPad(input,x_[offset],load,DataCopyPadExtParams<float>{false,0,0,0});
            DataCopyPad(input[capacity_],x_[offset+half_],load,DataCopyPadExtParams<float>{false,0,0,0});
            in_.EnQue(input); input=in_.DeQue<float>();
            auto output=out_.AllocTensor<float>();
            int32_t position=pos_.GetValue(token);
            if(position==0) {
                // The output queue supplies V->MTE3 ownership for this copy.
                DataCopy(output,input,count);
                DataCopy(output[capacity_],input[capacity_],count);
            } else {
                if(token!=lastToken) {
                    // Both output halves are scratch before rotation writes.
                    Muls(output,freq_.Get<float>(),static_cast<float>(position),pitch_);
                    SinCosFp32(output,c,s,tmp,output[capacity_],pitch_);
                    for(uint32_t h=1;h<tileHeads_;++h) {
                        DataCopy(c[h*pitch_],c,pitch_);
                        DataCopy(s[h*pitch_],s,pitch_);
                    }
                    lastToken=token;
                }
                Mul(tmp,input[capacity_],s,count);
                Mul(output,input,c,count);
                Sub(output,output,tmp,count);
                Mul(tmp,input,s,count);
                Mul(output[capacity_],input[capacity_],c,count);
                Add(output[capacity_],output[capacity_],tmp,count);
            }
            out_.EnQue(output); output=out_.DeQue<float>();
            DataCopyExtParams store{static_cast<uint16_t>(rows),width_*uint32_t(sizeof(float)),
                localGap,(dim_-width_)*uint32_t(sizeof(float)),0};
            DataCopyPad(y_[offset],output,store);
            DataCopyPad(y_[offset+half_],output[capacity_],store);
            PipeBarrier<PIPE_ALL>();
            in_.FreeTensor(input); out_.FreeTensor(output);
        }
    }
private:
    TPipe pipe_; TBuf<TPosition::VECCALC> frequencyMath_;
    TQue<QuePosition::VECIN,1> in_; TQue<QuePosition::VECOUT,1> out_;
    TBuf<TPosition::VECCALC> work_,freq_;
    GlobalTensor<float> x_,y_; GlobalTensor<int32_t> pos_;
    uint64_t tokens_;
    uint32_t heads_,dim_,half_,colStart_,width_,pitch_,tileHeads_,groups_,capacity_;
};

template <typename T,typename F=Frequencies>
__global__ __vector__ void rotary_kernel(GM_ADDR x, GM_ADDR positions, GM_ADDR y,
    uint64_t tokens, uint32_t heads, uint32_t dim, uint32_t colStart, uint32_t width, uint32_t tileHeads, F frequencies) {
    Rotary<T> op;
    op.Init(x, positions, y, tokens, heads, dim, colStart, width, tileHeads, frequencies);
    op.Process();
}
// All columns of wide dimensions execute in this one kernel. Each core owns
// complete half-pairs, so no inter-kernel scratch or second launch is needed.
template <typename T,typename F=Frequencies>
__global__ __vector__ void wide_kernel(GM_ADDR x, GM_ADDR positions, GM_ADDR y,
    uint64_t tokens, uint32_t heads, uint32_t dim, uint32_t tileHeads,
    F frequencies) {
    Rotary<T> op;
    op.Init(x, positions, y, tokens, heads, dim, 0, dim / 2, tileHeads, frequencies);
    op.Process();
}

// Aligned path: whole-row transfers and repeat-stride broadcasting. Double
// queues overlap the next MTE2 with current vector work and the previous MTE3.
template <typename T> class AlignedRotary {
public:
    template <typename F>
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR p, GM_ADDR y, uint64_t tokens,
                               uint32_t heads, uint32_t dim, uint32_t tileHeads,
                               const F& f) {
        x_.SetGlobalBuffer((__gm__ T*)x); y_.SetGlobalBuffer((__gm__ T*)y);
        pos_.SetGlobalBuffer((__gm__ int32_t*)p);
        tokens_=tokens; heads_=heads; dim_=dim; half_=dim/2;
        tileHeads_=tileHeads; groups_=(heads+tileHeads-1)/tileHeads;
        freqSize_=(half_+7)/8*8;
        size_=tileHeads*dim > freqSize_ ? tileHeads*dim : freqSize_;
        pipe_.InitBuffer(in_,2,size_*sizeof(T));
        pipe_.InitBuffer(out_,2,size_*sizeof(T));
        pipe_.InitBuffer(work_,2*size_*sizeof(float));
        batch_ = size_ / freqSize_;
        if (batch_ > 16) batch_ = 16;
        uint32_t baseBytes = 4*size_*sizeof(T) + 2*size_*sizeof(float);
        uint32_t cacheCap = (188*1024 - baseBytes - freqSize_*sizeof(float)) /
                            ((dim_<=64 && tileHeads_>=16?5u:3u)*freqSize_*sizeof(float));
        if (batch_ > cacheCap) batch_ = cacheCap;
        if (batch_ < 1) batch_ = 1;
        cacheSize_ = batch_ * freqSize_;
        fullCos_=(dim_<=64 && tileHeads_>=16);
        if(fullCos_)pipe_.InitBuffer(cosFull_,2*cacheSize_*sizeof(float));
        pipe_.InitBuffer(trig_,(freqSize_ + 3*cacheSize_)*sizeof(float));
        theta_=f.theta;
    }
    __aicore__ inline uint32_t Rows(uint64_t job) {
        uint32_t n=heads_-(job%groups_)*tileHeads_;
        return n<tileHeads_?n:tileHeads_;
    }
    __aicore__ inline uint64_t Offset(uint64_t job) {
        return (job/groups_*heads_+(job%groups_)*tileHeads_)*dim_;
    }
    __aicore__ inline void Prefetch(uint64_t job) {
        auto in=in_.AllocTensor<T>();
        DataCopyPad(in,x_[Offset(job)],{1,Rows(job)*dim_*uint32_t(sizeof(T)),0,0,0},
                    DataCopyPadExtParams<T>{false,0,0,0});
        in_.EnQue(in);
    }
    __aicore__ inline uint32_t TrigBatch(uint64_t token,uint64_t tokenLimit) {
        uint32_t count = tokenLimit-token < batch_ ? tokenLimit-token : batch_;
        auto freq=trig_.Get<float>();auto c=freq[freqSize_];auto s=c[cacheSize_];
        auto angle=s[cacheSize_];auto q=work_.Get<float>();auto temp=q[size_];
        for (uint32_t row=0;row<count;++row)
            Muls(angle[row*freqSize_],freq,static_cast<float>(pos_.GetValue(token+row)),freqSize_);
        
        SinCosFp32(angle,c,s,q,temp,count*freqSize_);
        Muls(angle,s,-1.0f,count*freqSize_);
        if(fullCos_) {
            auto expanded=cosFull_.Get<float>();
            DataCopyParams repeat{static_cast<uint16_t>(count),static_cast<uint16_t>(half_/8),0,static_cast<uint16_t>(half_/8)};
            DataCopy(expanded,c,repeat);DataCopy(expanded[half_],c,repeat);
        }
        return count;
    }
    template <typename F>
    __aicore__ inline void Process() {
        uint64_t jobs=tokens_*groups_;
        uint64_t begin=jobs*GetBlockIdx()/GetBlockNum();
        uint64_t end=jobs*(GetBlockIdx()+1)/GetBlockNum();
        if(begin==end)return;
        Prefetch(begin);
        F frequencyParameters{theta_};
        FillDeviceFrequencies(pipe_,frequencyMath_,trig_.Get<float>(),frequencyParameters,half_,freqSize_,work_.Get<float>());

        uint64_t cached=static_cast<uint64_t>(-1);
        uint32_t cachedCount=0;
        auto z=work_.Get<float>();auto r=z[size_];
        auto cosCache=trig_.Get<float>()[freqSize_];auto sinCache=cosCache[cacheSize_];
        auto negCache=sinCache[cacheSize_];
        uint8_t stride=dim_/8;
        BinaryRepeatParams broadcast{1,1,1,stride,stride,0};
        BinaryRepeatParams paired{1,1,1,stride,stride,stride};
        for(uint64_t job=begin;job<end;++job) {
            auto input=in_.DeQue<T>();
            if(job+1<end)Prefetch(job+1);
            uint64_t token=job/groups_;
            int32_t position=pos_.GetValue(token);
            uint32_t rows=Rows(job), count=rows*dim_;
            auto output=out_.AllocTensor<T>();
            if(position==0) {
                DataCopy(output,input,count);
            } else {
                if(cached==static_cast<uint64_t>(-1) || token>=cached+cachedCount) {
                    cachedCount=TrigBatch(token,(end-1)/groups_+1);
                    cached=token;
                }
                uint32_t trigOffset=(token-cached)*freqSize_;
                auto c=cosCache[trigOffset];auto s=sinCache[trigOffset];auto negs=negCache[trigOffset];
                LoadFp32(z,input,count);
                
                if(fullCos_) {
                    auto full=cosFull_.Get<float>()[(token-cached)*dim_];
                    Mul(r,z,full,dim_,rows,broadcast);
                } else {
                for(uint32_t col=0;col<half_;col+=64) {
                    uint64_t mask=half_-col<64?half_-col:64;
                    Mul(r[col],z[col],c[col],mask,rows,broadcast);
                    Mul(r[half_+col],z[half_+col],c[col],mask,rows,broadcast);
                }
                }
                
                for(uint32_t col=0;col<half_;col+=64) {
                    uint64_t mask=half_-col<64?half_-col:64;
                    MulAddDst(r[col],z[half_+col],negs[col],mask,rows,broadcast);
                    MulAddDst(r[half_+col],z[col],s[col],mask,rows,broadcast);
                }
                
                StoreFp32(output,r,count);
            }
            out_.EnQue(output);output=out_.DeQue<T>();
            DataCopyPad(y_[Offset(job)],output,{1,count*uint32_t(sizeof(T)),0,0,0});
            in_.FreeTensor(input);out_.FreeTensor(output);
        }
        PipeBarrier<PIPE_ALL>();
    }
private:
    float theta_;
    TPipe pipe_; TBuf<TPosition::VECCALC> frequencyMath_;
    TQue<QuePosition::VECIN,2> in_;
    TQue<QuePosition::VECOUT,2> out_;
    TBuf<TPosition::VECCALC> work_,trig_,cosFull_;
    bool fullCos_;
    GlobalTensor<T> x_,y_;
    GlobalTensor<int32_t> pos_;
    uint64_t tokens_;
    uint32_t heads_,dim_,half_,tileHeads_,groups_,size_,freqSize_,batch_,cacheSize_;
};
template <typename T,typename F=Frequencies>
__global__ __vector__ void aligned_kernel(GM_ADDR x,GM_ADDR positions,GM_ADDR y,
    uint64_t tokens,uint32_t heads,uint32_t dim,uint32_t tileHeads,F frequencies) {
    AlignedRotary<T> op;op.Init(x,positions,y,tokens,heads,dim,tileHeads,frequencies);op.template Process<F>();
}

template <typename T,typename F=Frequencies>
__global__ __vector__ void wide_aligned_kernel(GM_ADDR x,GM_ADDR positions,GM_ADDR y,
    uint64_t tokens,uint32_t heads,uint32_t dim,uint32_t tileHeads,F frequencies) {
    AlignedRotary<T> op;op.Init(x,positions,y,tokens,heads,dim,tileHeads,frequencies);op.template Process<F>();
}

// H=1: combine tokens so the expensive transcendental work fills SIMD lanes.
// In contrast to head tiling, each row has its own position and angle vector.
template <typename T> class BatchedRotary {
public:
    template <typename F>
    __aicore__ inline void Init(GM_ADDR x,GM_ADDR p,GM_ADDR y,uint64_t tokens,
        uint32_t dim,uint32_t tileTokens,const F& f) {
        x_.SetGlobalBuffer((__gm__ T*)x);y_.SetGlobalBuffer((__gm__ T*)y);
        pos_.SetGlobalBuffer((__gm__ int32_t*)p);
        tokens_=tokens;dim_=dim;half_=dim/2;tile_=tileTokens;size_=tile_*dim;pair_=size_/2;
        pipe_.InitBuffer(in_,2,size_*sizeof(T));pipe_.InitBuffer(out_,2,size_*sizeof(T));
        pipe_.InitBuffer(work_,3*size_*sizeof(float));
        pipe_.InitBuffer(trig_,3*pair_*sizeof(float));
        pipe_.InitBuffer(freq_,(half_>256?512:((half_+7)/8*8))*sizeof(float));
        auto freq=freq_.Get<float>();
        FillDeviceFrequencies(pipe_,frequencyMath_,freq,f,half_,(half_+7)/8*8,work_.Get<float>());
    }
    __aicore__ inline uint32_t Rows(uint64_t job) {
        uint64_t n=tokens_-job*tile_;return n<tile_?n:tile_;
    }
    __aicore__ inline void Prefetch(uint64_t job) {
        auto in=in_.AllocTensor<T>();
        DataCopyPad(in,x_[job*tile_*dim_],{1,Rows(job)*dim_*uint32_t(sizeof(T)),0,0,0},
                    DataCopyPadExtParams<T>{false,0,0,0});in_.EnQue(in);
    }
    __aicore__ inline void Process() {
        uint64_t jobs=(tokens_+tile_-1)/tile_;
        uint64_t begin=jobs*GetBlockIdx()/GetBlockNum(),end=jobs*(GetBlockIdx()+1)/GetBlockNum();
        if(begin==end)return;
        Prefetch(begin);
        auto z=work_.Get<float>();auto r=z[size_];auto t=z[2*size_];
        auto angle=trig_.Get<float>();auto c=angle[pair_];auto s=angle[2*pair_];
        BinaryRepeatParams pairs{1,1,1,uint8_t(dim_/8),uint8_t(dim_/8),uint8_t(half_/8)};
        BinaryRepeatParams same{1,1,1,uint8_t(dim_/8),uint8_t(dim_/8),uint8_t(dim_/8)};
        for(uint64_t job=begin;job<end;++job) {
            auto input=in_.DeQue<T>();if(job+1<end)Prefetch(job+1);
            uint32_t rows=Rows(job),count=rows*dim_;
            for(uint32_t row=0;row<rows;++row) {
                float p=static_cast<float>(pos_.GetValue(job*tile_+row));
                Muls(angle[row*half_],freq_.Get<float>(),p,half_);
            }
            
            SinCosFp32(angle,c,s,z,r,rows*half_);
            LoadFp32(z,input,count);
            
            for(uint32_t col=0;col<half_;col+=64) {
                uint64_t mask=half_-col<64?half_-col:64;
                Mul(r[col],z[col],c[col],mask,rows,pairs);
                Mul(t[col],z[half_+col],s[col],mask,rows,pairs);
                Mul(r[half_+col],z[half_+col],c[col],mask,rows,pairs);
                Mul(t[half_+col],z[col],s[col],mask,rows,pairs);
            }
            
            for(uint32_t col=0;col<half_;col+=64) {
                uint64_t mask=half_-col<64?half_-col:64;
                Sub(r[col],r[col],t[col],mask,rows,same);
                Add(r[half_+col],r[half_+col],t[half_+col],mask,rows,same);
            }
            
            auto output=out_.AllocTensor<T>();
            StoreFp32(output,r,count);
            
            // Preserve exact identity for zero positions, including NaN/Inf and signed zero.
            for(uint32_t row=0;row<rows;++row)
                if(pos_.GetValue(job*tile_+row)==0)DataCopy(output[row*dim_],input[row*dim_],dim_);
            out_.EnQue(output);output=out_.DeQue<T>();
            DataCopyPad(y_[job*tile_*dim_],output,{1,count*uint32_t(sizeof(T)),0,0,0});
            in_.FreeTensor(input);out_.FreeTensor(output);
        }
        PipeBarrier<PIPE_ALL>();
    }
private:
    TPipe pipe_; TBuf<TPosition::VECCALC> frequencyMath_;TQue<QuePosition::VECIN,2> in_;TQue<QuePosition::VECOUT,2> out_;
    TBuf<TPosition::VECCALC> work_,trig_,freq_;
    GlobalTensor<T> x_,y_;GlobalTensor<int32_t> pos_;
    uint64_t tokens_;uint32_t dim_,half_,tile_,size_,pair_;
};
template <typename T,typename F=Frequencies>
__global__ __vector__ void batched_kernel(GM_ADDR x,GM_ADDR p,GM_ADDR y,uint64_t tokens,
    uint32_t dim,uint32_t tileTokens,F f) {
    BatchedRotary<T> op;op.Init(x,p,y,tokens,dim,tileTokens,f);op.Process();
}

template <typename T,typename F=Frequencies>
__global__ __vector__ void wide_batched_kernel(GM_ADDR x,GM_ADDR p,GM_ADDR y,uint64_t tokens,
    uint32_t dim,uint32_t tile,F f) {
    BatchedRotary<T> op;op.Init(x,p,y,tokens,dim,tile,f);op.Process();
}

template <typename T> class LargeAlignedRotary {
public:
    template <typename F>
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR p, GM_ADDR y, uint64_t tokens,
                               uint32_t heads, uint32_t dim, uint32_t tileHeads,
                               const F& f) {
        x_.SetGlobalBuffer((__gm__ T*)x); y_.SetGlobalBuffer((__gm__ T*)y);
        pos_.SetGlobalBuffer((__gm__ int32_t*)p);
        tokens_=tokens; heads_=heads; dim_=dim; half_=dim/2;
        tileHeads_=tileHeads; groups_=(heads+tileHeads-1)/tileHeads;
        freqSize_=(half_+7)/8*8;
        size_=tileHeads*dim > freqSize_ ? tileHeads*dim : freqSize_;
        pipe_.InitBuffer(in_,2,size_*sizeof(T));
        pipe_.InitBuffer(out_,1,size_*sizeof(T));
        workStride_=size_+8;
        pipe_.InitBuffer(work_,2*workStride_*sizeof(float));
        batch_ = size_ / freqSize_;
        if (batch_ > 16) batch_ = 16;
        uint32_t baseBytes = 3*size_*sizeof(T) + 2*workStride_*sizeof(float);
        uint32_t cacheCap = (188*1024 - baseBytes - freqSize_*sizeof(float)) /
                            (3*freqSize_*sizeof(float));
        if (batch_ > cacheCap) batch_ = cacheCap;
        if (batch_ < 1) batch_ = 1;
        cacheSize_ = batch_ * freqSize_;
        pipe_.InitBuffer(trig_,(freqSize_ + 3*cacheSize_)*sizeof(float));
        theta_=f.theta;
    }
    __aicore__ inline uint32_t Rows(uint64_t job) {
        uint32_t n=heads_-(job%groups_)*tileHeads_;
        return n<tileHeads_?n:tileHeads_;
    }
    __aicore__ inline uint64_t Offset(uint64_t job) {
        return (job/groups_*heads_+(job%groups_)*tileHeads_)*dim_;
    }
    __aicore__ inline void Prefetch(uint64_t job) {
        auto in=in_.AllocTensor<T>();
        DataCopyPad(in,x_[Offset(job)],{1,Rows(job)*dim_*uint32_t(sizeof(T)),0,0,0},
                    DataCopyPadExtParams<T>{false,0,0,0});
        in_.EnQue(in);
    }
    __aicore__ inline uint32_t TrigBatch(uint64_t token,uint64_t tokenLimit) {
        uint32_t count = tokenLimit-token < batch_ ? tokenLimit-token : batch_;
        auto freq=trig_.Get<float>();auto c=freq[freqSize_];auto s=c[cacheSize_];
        auto angle=s[cacheSize_];auto q=work_.Get<float>();auto temp=q[workStride_];
        for (uint32_t row=0;row<count;++row)
            Muls(angle[row*freqSize_],freq,static_cast<float>(pos_.GetValue(token+row)),freqSize_);
        
        SinCosFp32(angle,c,s,q,temp,count*freqSize_);
        Muls(angle,s,-1.0f,count*freqSize_);
        return count;
    }
    template <typename F, bool useWideFma = false>
    __aicore__ inline void Process() {
        uint64_t jobs=tokens_*groups_;
        uint64_t begin=jobs*GetBlockIdx()/GetBlockNum();
        uint64_t end=jobs*(GetBlockIdx()+1)/GetBlockNum();
        if(begin==end)return;
        Prefetch(begin);
        F frequencyParameters{theta_};
        FillDeviceFrequencies(pipe_,frequencyMath_,trig_.Get<float>(),frequencyParameters,half_,freqSize_,work_.Get<float>());

        uint64_t cached=static_cast<uint64_t>(-1);
        uint32_t cachedCount=0;
        auto z=work_.Get<float>();auto r=z[workStride_];
        auto cosCache=trig_.Get<float>()[freqSize_];auto sinCache=cosCache[cacheSize_];
        auto negCache=sinCache[cacheSize_];
        uint8_t stride=dim_/8;
        BinaryRepeatParams broadcast{1,1,1,stride,stride,0};
        BinaryRepeatParams paired{1,1,1,stride,stride,stride};
        for(uint64_t job=begin;job<end;++job) {
            auto input=in_.DeQue<T>();
            if(job+1<end)Prefetch(job+1);
            uint64_t token=job/groups_;
            int32_t position=pos_.GetValue(token);
            uint32_t rows=Rows(job), count=rows*dim_;
            LocalTensor<T> output;
            if(position==0) {
                output=out_.AllocTensor<T>();
                DataCopy(output,input,count);
            } else {
                if(cached==static_cast<uint64_t>(-1) || token>=cached+cachedCount) {
                    cachedCount=TrigBatch(token,(end-1)/groups_+1);
                    cached=token;
                }
                uint32_t trigOffset=(token-cached)*freqSize_;
                auto c=cosCache[trigOffset];auto s=sinCache[trigOffset];auto negs=negCache[trigOffset];
                LoadFp32(z,input,count);
                
                if (useWideFma && dim_ > 512 && heads_ > 1) {
                    // Both cross products consume the original z before either
                    // half is overwritten. vmadd retains product-then-add rounding.
                    BinaryRepeatParams cosAndCross{1,1,1,stride,0,stride};
                    for(uint32_t col=0;col<half_;col+=64) {
                        uint64_t mask=half_-col<64?half_-col:64;
                        Mul(r[col],z[half_+col],negs[col],mask,rows,broadcast);
                        Mul(r[half_+col],z[col],s[col],mask,rows,broadcast);
                    }
                    for(uint32_t col=0;col<half_;col+=64) {
                        uint64_t mask=half_-col<64?half_-col:64;
                        FusedMulAdd(z[col],c[col],r[col],mask,rows,cosAndCross);
                        FusedMulAdd(z[half_+col],c[col],r[half_+col],mask,rows,cosAndCross);
                    }
                    output=out_.AllocTensor<T>();
                    StoreFp32(output,z,count);
                } else {
                    for(uint32_t col=0;col<half_;col+=64) {
                        uint64_t mask=half_-col<64?half_-col:64;
                        Mul(r[col],z[col],c[col],mask,rows,broadcast);
                        Mul(r[half_+col],z[half_+col],c[col],mask,rows,broadcast);
                    }
                    
                    for(uint32_t col=0;col<half_;col+=64) {
                        uint64_t mask=half_-col<64?half_-col:64;
                        MulAddDst(r[col],z[half_+col],negs[col],mask,rows,broadcast);
                        MulAddDst(r[half_+col],z[col],s[col],mask,rows,broadcast);
                    }
                    
                    output=out_.AllocTensor<T>();
                    StoreFp32(output,r,count);
                }
            }
            out_.EnQue(output);output=out_.DeQue<T>();
            DataCopyPad(y_[Offset(job)],output,{1,count*uint32_t(sizeof(T)),0,0,0});
            in_.FreeTensor(input);out_.FreeTensor(output);
        }
        PipeBarrier<PIPE_ALL>();
    }
private:
    float theta_;
    TPipe pipe_; TBuf<TPosition::VECCALC> frequencyMath_;
    TQue<QuePosition::VECIN,2> in_;
    TQue<QuePosition::VECOUT,2> out_;
    TBuf<TPosition::VECCALC> work_,trig_;
    GlobalTensor<T> x_,y_;
    GlobalTensor<int32_t> pos_;
    uint64_t tokens_;
    uint32_t heads_,dim_,half_,tileHeads_,groups_,size_,freqSize_,batch_,cacheSize_,workStride_;
};
template <typename T,typename F=Frequencies>
__global__ __vector__ void large_aligned_kernel(GM_ADDR x,GM_ADDR positions,GM_ADDR y,
    uint64_t tokens,uint32_t heads,uint32_t dim,uint32_t tileHeads,F frequencies) {
    LargeAlignedRotary<T> op;op.Init(x,positions,y,tokens,heads,dim,tileHeads,frequencies);op.template Process<F>();
}

template <typename T,typename F=Frequencies>
__global__ __vector__ void large_wide_kernel(GM_ADDR x,GM_ADDR positions,GM_ADDR y,
    uint64_t tokens,uint32_t heads,uint32_t dim,uint32_t tileHeads,F frequencies) {
    LargeAlignedRotary<T> op;op.Init(x,positions,y,tokens,heads,dim,tileHeads,frequencies);op.template Process<F,true>();
}

// Continuous token tiles; UB gathers separate and rejoin rotate-half pairs.
template <typename T> class PackedRotary {
public:
    template <typename F>
    __aicore__ inline void Init(GM_ADDR x,GM_ADDR p,GM_ADDR y,uint64_t tokens,
        uint32_t heads,uint32_t dim,uint32_t tileTokens,const F& f) {
        x_.SetGlobalBuffer((__gm__ T*)x);pos_.SetGlobalBuffer((__gm__ int32_t*)p);
        y_.SetGlobalBuffer((__gm__ T*)y);
        tokens_=tokens;heads_=heads;dim_=dim;half_=dim/2;pitch_=(half_+15)/16*16;
        tile_=tileTokens;rows_=tile_*heads_;capacity_=rows_*pitch_;
        pipe_.InitBuffer(in_,2,2*capacity_*sizeof(T));
        pipe_.InitBuffer(out_,2,2*capacity_*sizeof(T));
        pipe_.InitBuffer(work_,6*capacity_*sizeof(float));
        pipe_.InitBuffer(index_,5*capacity_*sizeof(uint32_t));
        pipe_.InitBuffer(freq_,pitch_*sizeof(float));
        pipe_.InitBuffer(mask_,((2*capacity_+255)/256*32));
        auto freq=freq_.Get<float>();
        FillDeviceFrequencies(pipe_,frequencyMath_,freq,f,half_,pitch_,work_.Get<float>());
        InitIndexes();
        PipeBarrier<PIPE_ALL>();
    }
    __aicore__ inline void InitIndexes() {
        auto low=index_.Get<int32_t>();auto high=low[capacity_];
        auto trig=low[2*capacity_];auto packed=low[3*capacity_];
        for(uint32_t i=0;i<pitch_;++i) {
            low.SetValue(i,int32_t((i<half_?i:0)*4));
            trig.SetValue(i,int32_t(i*4));
        }
        PipeBarrier<PIPE_ALL>();
        for(uint32_t built=1;built<rows_;built*=2) {
            uint32_t more=rows_-built<built?rows_-built:built;
            Adds(low[built*pitch_],low,int32_t(built*dim_*4),more*pitch_);
        }
        Adds(high,low,int32_t(half_*4),capacity_);
        for(uint32_t built=1;built<heads_;built*=2) {
            uint32_t more=heads_-built<built?heads_-built:built;
            DataCopy(trig[built*pitch_],trig,more*pitch_);
        }
        for(uint32_t built=1;built<tile_;built*=2) {
            uint32_t more=tile_-built<built?tile_-built:built;
            Adds(trig[built*heads_*pitch_],trig,int32_t(built*pitch_*4),more*heads_*pitch_);
        }
        Duplicate(packed,int32_t(0),2*capacity_);
        PipeBarrier<PIPE_ALL>();
        uint32_t unit=1;
        while((unit*dim_)%8!=0)++unit;
        uint32_t first=rows_<unit?rows_:unit;
        for(uint32_t h=0;h<first;++h)
            for(uint32_t i=0;i<dim_;++i)
                packed.SetValue(h*dim_+i,int32_t((h*pitch_+(i<half_?i:capacity_+i-half_))*4));
        PipeBarrier<PIPE_ALL>();
        for(uint32_t built=first;built<rows_;built*=2) {
            uint32_t more=rows_-built<built?rows_-built:built;
            Adds(packed[built*dim_],packed,int32_t(built*pitch_*4),more*dim_);
        }
    }
    __aicore__ inline uint32_t Tokens(uint64_t job) {
        uint64_t n=tokens_-job*tile_;return n<tile_?n:tile_;
    }
    __aicore__ inline uint64_t Offset(uint64_t job) { return job*tile_*heads_*dim_; }
    __aicore__ inline void Prefetch(uint64_t job) {
        auto input=in_.AllocTensor<T>();
        DataCopyPad(input,x_[Offset(job)],{1,Tokens(job)*heads_*dim_*uint32_t(sizeof(T)),0,0,0},
            DataCopyPadExtParams<T>{false,0,0,0});
        in_.EnQue(input);
    }
    __aicore__ inline void Process() {
        uint64_t jobs=(tokens_+tile_-1)/tile_;
        uint64_t begin=jobs*GetBlockIdx()/GetBlockNum(),end=jobs*(GetBlockIdx()+1)/GetBlockNum();
        if(begin==end)return;
        Prefetch(begin);
        auto z=work_.Get<float>();auto lo=z[2*capacity_];auto hi=lo[capacity_];
        auto c=z[4*capacity_];auto s=c[capacity_];
        auto index=index_.Get<uint32_t>();auto high=index[capacity_];
        auto trig=index[2*capacity_];auto packed=index[3*capacity_];
        for(uint64_t job=begin;job<end;++job) {
            auto input=in_.DeQue<T>();if(job+1<end)Prefetch(job+1);
            uint32_t tokenCount=Tokens(job),n=tokenCount*heads_*dim_;
            uint32_t aligned=(n+7)/8*8,pairs=tokenCount*heads_*pitch_;
            uint64_t zeroBits=0;
            for(uint32_t row=0;row<tokenCount;++row) {
                int32_t position=pos_.GetValue(job*tile_+row);
                if(position==0)zeroBits|=(uint64_t(1)<<row);
                Muls(lo[row*pitch_],freq_.Get<float>(),static_cast<float>(position),pitch_);
            }
            uint64_t allZero=tokenCount==64?UINT64_MAX:((uint64_t(1)<<tokenCount)-1);
            if(zeroBits==allZero) {
                PipeBarrier<PIPE_ALL>();
                DataCopyPad(y_[Offset(job)],input,{1,n*uint32_t(sizeof(T)),0,0,0});
                PipeBarrier<PIPE_ALL>();in_.FreeTensor(input);continue;
            }
            SinCosFp32(lo,c,s,z,z[capacity_],tokenCount*pitch_);
            PipeBarrier<PIPE_V>();
            Gather(z,c,trig,0,pairs);Gather(z[capacity_],s,trig,0,pairs);
            PipeBarrier<PIPE_V>();
            LoadFp32(c,input,aligned);
            PipeBarrier<PIPE_V>();
            Gather(lo,c,index,0,pairs);Gather(hi,c,high,0,pairs);
            PipeBarrier<PIPE_V>();
            Mul(c,lo,z,pairs);Mul(s,hi,z,pairs);
            PipeBarrier<PIPE_V>();
            MulAddDst(s,lo,z[capacity_],pairs);
            PipeBarrier<PIPE_V>();
            Muls(z[capacity_],z[capacity_],-1.0f,pairs);
            PipeBarrier<PIPE_V>();
            MulAddDst(c,hi,z[capacity_],pairs);
            PipeBarrier<PIPE_V>();
            Gather(lo,c,packed,0,aligned);
            PipeBarrier<PIPE_V>();
            auto output=out_.AllocTensor<T>();StoreFp32(output,lo,aligned);
            PipeBarrier<PIPE_V>();
            if(zeroBits) {
                for(uint32_t row=0;row<tokenCount;++row)
                    Duplicate(z[row*heads_*pitch_],(zeroBits&(uint64_t(1)<<row))?1.0f:0.0f,heads_*pitch_);
                PipeBarrier<PIPE_V>();DataCopy(z[capacity_],z,capacity_);
                PipeBarrier<PIPE_V>();
                Gather(lo,z,packed,0,aligned);
                PipeBarrier<PIPE_V>();
                // CANN 9.0 compare-count API processes full 64-float repeats.
                CompareScalar(mask_.Get<uint8_t>(),lo,0.5f,CMPMODE::GT,(aligned+63)/64*64);
                PipeBarrier<PIPE_V>();
                Select(output,mask_.Get<uint8_t>(),input,output,SELMODE::VSEL_TENSOR_TENSOR_MODE,aligned);
            }
            out_.EnQue(output);output=out_.DeQue<T>();
            DataCopyPad(y_[Offset(job)],output,{1,n*uint32_t(sizeof(T)),0,0,0});
            in_.FreeTensor(input);out_.FreeTensor(output);
        }
        PipeBarrier<PIPE_ALL>();
    }
private:
    TPipe pipe_; TBuf<TPosition::VECCALC> frequencyMath_;TQue<QuePosition::VECIN,2> in_;TQue<QuePosition::VECOUT,2> out_;
    TBuf<TPosition::VECCALC> work_,index_,freq_,mask_;
    GlobalTensor<T> x_,y_;GlobalTensor<int32_t> pos_;uint64_t tokens_;
    uint32_t heads_,dim_,half_,pitch_,tile_,rows_,capacity_;
};
template <typename T,typename F=Frequencies>
__global__ __vector__ void packed_kernel(GM_ADDR x,GM_ADDR p,GM_ADDR y,uint64_t tokens,
    uint32_t heads,uint32_t dim,uint32_t tile,F f) {
    PackedRotary<T> op;op.Init(x,p,y,tokens,heads,dim,tile,f);op.Process();
}

template <typename T> class HeadTileRotary {
public:
    template <typename F>
    __aicore__ inline void Init(GM_ADDR x,GM_ADDR p,GM_ADDR y,uint64_t tokens,
        uint32_t heads,uint32_t dim,uint32_t tileTokens,const F& f) {
        x_.SetGlobalBuffer((__gm__ T*)x);pos_.SetGlobalBuffer((__gm__ int32_t*)p);
        y_.SetGlobalBuffer((__gm__ T*)y);
        tokens_=tokens;heads_=heads;dim_=dim;half_=dim/2;pitch_=(half_+15)/16*16;
        tile_=tileTokens;rows_=tile_;groups_=(heads_+tile_-1)/tile_;capacity_=rows_*pitch_;
        pipe_.InitBuffer(in_,2,2*capacity_*sizeof(T));
        pipe_.InitBuffer(out_,2,2*capacity_*sizeof(T));
        pipe_.InitBuffer(work_,6*capacity_*sizeof(float));
        pipe_.InitBuffer(index_,5*capacity_*sizeof(uint32_t));
        pipe_.InitBuffer(freq_,pitch_*sizeof(float));
        pipe_.InitBuffer(mask_,((2*capacity_+255)/256*32));
        auto freq=freq_.Get<float>();
        FillDeviceFrequencies(pipe_,frequencyMath_,freq,f,half_,pitch_,work_.Get<float>());
        InitIndexes();
        PipeBarrier<PIPE_ALL>();
    }
    __aicore__ inline void InitIndexes() {
        auto low=index_.Get<int32_t>();auto high=low[capacity_];
        auto trig=low[2*capacity_];auto packed=low[3*capacity_];
        for(uint32_t i=0;i<pitch_;++i) {
            low.SetValue(i,int32_t((i<half_?i:0)*4));
            trig.SetValue(i,int32_t(i*4));
        }
        PipeBarrier<PIPE_ALL>();
        for(uint32_t built=1;built<rows_;built*=2) {
            uint32_t more=rows_-built<built?rows_-built:built;
            Adds(low[built*pitch_],low,int32_t(built*dim_*4),more*pitch_);
        }
        Adds(high,low,int32_t(half_*4),capacity_);
        for(uint32_t built=1;built<rows_;built*=2) {
            uint32_t more=rows_-built<built?rows_-built:built;
            DataCopy(trig[built*pitch_],trig,more*pitch_);
        }
        Duplicate(packed,int32_t(0),2*capacity_);
        PipeBarrier<PIPE_ALL>();
        uint32_t unit=1;
        while((unit*dim_)%8!=0)++unit;
        uint32_t first=rows_<unit?rows_:unit;
        for(uint32_t h=0;h<first;++h)
            for(uint32_t i=0;i<dim_;++i)
                packed.SetValue(h*dim_+i,int32_t((h*pitch_+(i<half_?i:capacity_+i-half_))*4));
        PipeBarrier<PIPE_ALL>();
        for(uint32_t built=first;built<rows_;built*=2) {
            uint32_t more=rows_-built<built?rows_-built:built;
            Adds(packed[built*dim_],packed,int32_t(built*pitch_*4),more*dim_);
        }
    }
    __aicore__ inline uint32_t Rows(uint64_t job) {
        uint32_t left=heads_-(job%groups_)*tile_;return left<tile_?left:tile_;
    }
    __aicore__ inline uint64_t Offset(uint64_t job) {
        return (job/groups_*heads_+(job%groups_)*tile_)*dim_;
    }
    __aicore__ inline void Prefetch(uint64_t job) {
        auto input=in_.AllocTensor<T>();
        DataCopyPad(input,x_[Offset(job)],{1,Rows(job)*dim_*uint32_t(sizeof(T)),0,0,0},
            DataCopyPadExtParams<T>{false,0,0,0});in_.EnQue(input);
    }
    __aicore__ inline void Process() {
        uint64_t jobs=tokens_*groups_;
        uint64_t begin=jobs*GetBlockIdx()/GetBlockNum(),end=jobs*(GetBlockIdx()+1)/GetBlockNum();
        if(begin==end)return;Prefetch(begin);
        auto z=work_.Get<float>();auto lo=z[2*capacity_];auto hi=lo[capacity_];
        auto c=z[4*capacity_];auto s=c[capacity_];
        auto index=index_.Get<uint32_t>();auto high=index[capacity_];
        auto trig=index[2*capacity_];auto packed=index[3*capacity_];
        for(uint64_t job=begin;job<end;++job) {
            auto input=in_.DeQue<T>();if(job+1<end)Prefetch(job+1);
            uint32_t n=Rows(job)*dim_,aligned=(n+7)/8*8,pairs=Rows(job)*pitch_;
            int32_t p=pos_.GetValue(job/groups_);
            if(p==0) {
                PipeBarrier<PIPE_ALL>();
                DataCopyPad(y_[Offset(job)],input,{1,n*uint32_t(sizeof(T)),0,0,0});
                PipeBarrier<PIPE_ALL>();in_.FreeTensor(input);continue;
            }
            Muls(lo,freq_.Get<float>(),static_cast<float>(p),pitch_);
            SinCosFp32(lo,c,s,z,z[capacity_],pitch_);
            PipeBarrier<PIPE_V>();
            Gather(z,c,trig,0,pairs);Gather(z[capacity_],s,trig,0,pairs);
            PipeBarrier<PIPE_V>();LoadFp32(c,input,aligned);
            PipeBarrier<PIPE_V>();
            Gather(lo,c,index,0,pairs);Gather(hi,c,high,0,pairs);
            PipeBarrier<PIPE_V>();
            Mul(c,lo,z,pairs);Mul(s,hi,z,pairs);
            // Preserve V4's four FP32 products and separate subtraction/addition.
            // Only DMA/layout changes; no half intermediates or fused arithmetic.
            PipeBarrier<PIPE_V>();Mul(z,hi,z[capacity_],pairs);
            PipeBarrier<PIPE_V>();Sub(c,c,z,pairs);
            PipeBarrier<PIPE_V>();Mul(z,lo,z[capacity_],pairs);
            PipeBarrier<PIPE_V>();Add(s,s,z,pairs);
            PipeBarrier<PIPE_V>();Gather(lo,c,packed,0,aligned);
            PipeBarrier<PIPE_V>();auto output=out_.AllocTensor<T>();StoreFp32(output,lo,aligned);
            out_.EnQue(output);output=out_.DeQue<T>();
            DataCopyPad(y_[Offset(job)],output,{1,n*uint32_t(sizeof(T)),0,0,0});
            in_.FreeTensor(input);out_.FreeTensor(output);
        }
        PipeBarrier<PIPE_ALL>();
    }
private:
    TPipe pipe_; TBuf<TPosition::VECCALC> frequencyMath_;TQue<QuePosition::VECIN,2> in_;TQue<QuePosition::VECOUT,2> out_;
    TBuf<TPosition::VECCALC> work_,index_,freq_,mask_;
    GlobalTensor<T> x_,y_;GlobalTensor<int32_t> pos_;uint64_t tokens_;
    uint32_t heads_,dim_,half_,pitch_,tile_,rows_,capacity_,groups_;
};
template <typename T,typename F=Frequencies>
__global__ __vector__ void head_tile_kernel(GM_ADDR x,GM_ADDR p,GM_ADDR y,uint64_t tokens,
    uint32_t heads,uint32_t dim,uint32_t tile,F f) {
    HeadTileRotary<T> op;op.Init(x,p,y,tokens,heads,dim,tile,f);op.Process();
}

class DirectFloatRotary {
public:
    template <typename F>
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR p, GM_ADDR y, uint64_t tokens,
                               uint32_t heads, uint32_t dim, uint32_t tileHeads,
                               const F& f) {
        x_.SetGlobalBuffer((__gm__ float*)x); y_.SetGlobalBuffer((__gm__ float*)y);
        pos_.SetGlobalBuffer((__gm__ int32_t*)p);
        tokens_=tokens; heads_=heads; dim_=dim; half_=dim/2;
        tileHeads_=tileHeads; groups_=(heads+tileHeads-1)/tileHeads;
        freqSize_=(half_+7)/8*8;
        size_=tileHeads*dim > freqSize_ ? tileHeads*dim : freqSize_;
        pipe_.InitBuffer(in_,2,(size_+8)*sizeof(float));
        pipe_.InitBuffer(out_,2,(size_+8)*sizeof(float));
        batch_ = size_ / (2*freqSize_);
        if (batch_ > 16) batch_ = 16;
        uint32_t baseBytes = 4*(size_+8)*sizeof(float);
        uint32_t cacheCap = (188*1024 - baseBytes - freqSize_*sizeof(float)) /
                            (3*freqSize_*sizeof(float));
        if (batch_ > cacheCap) batch_ = cacheCap;
        if (batch_ < 1) batch_ = 1;
        cacheSize_ = batch_ * freqSize_;
        pipe_.InitBuffer(trig_,(freqSize_ + 3*cacheSize_)*sizeof(float));
        theta_=f.theta;
    }
    __aicore__ inline uint32_t Rows(uint64_t job) {
        uint32_t n=heads_-(job%groups_)*tileHeads_;
        return n<tileHeads_?n:tileHeads_;
    }
    __aicore__ inline uint64_t Offset(uint64_t job) {
        return (job/groups_*heads_+(job%groups_)*tileHeads_)*dim_;
    }
    __aicore__ inline void Prefetch(uint64_t job) {
        auto in=in_.AllocTensor<float>();
        DataCopyPad(in,x_[Offset(job)],{1,Rows(job)*dim_*uint32_t(sizeof(float)),0,0,0},
                    DataCopyPadExtParams<float>{false,0,0,0});
        in_.EnQue(in);
    }
    __aicore__ inline uint32_t TrigBatch(uint64_t token,uint64_t tokenLimit,const LocalTensor<float>& output) {
        uint32_t count = tokenLimit-token < batch_ ? tokenLimit-token : batch_;
        auto freq=trig_.Get<float>();auto c=freq[freqSize_];auto s=c[cacheSize_];
        auto angle=s[cacheSize_];auto q=output;auto temp=output[cacheSize_];
        for (uint32_t row=0;row<count;++row)
            Muls(angle[row*freqSize_],freq,static_cast<float>(pos_.GetValue(token+row)),freqSize_);
        
        SinCosFp32(angle,c,s,q,temp,count*freqSize_);
        Muls(angle,s,-1.0f,count*freqSize_);
        return count;
    }
    template <typename F>
    __aicore__ inline void Process() {
        uint64_t jobs=tokens_*groups_;
        uint64_t begin=jobs*GetBlockIdx()/GetBlockNum();
        uint64_t end=jobs*(GetBlockIdx()+1)/GetBlockNum();
        if(begin==end)return;
        Prefetch(begin);
        F frequencyParameters{theta_};
        auto frequencyScratch=out_.AllocTensor<float>();
        FillDeviceFrequencies(pipe_,frequencyMath_,trig_.Get<float>(),frequencyParameters,half_,freqSize_,frequencyScratch);
        out_.FreeTensor(frequencyScratch);

        uint64_t cached=static_cast<uint64_t>(-1);
        uint32_t cachedCount=0;
        auto cosCache=trig_.Get<float>()[freqSize_];auto sinCache=cosCache[cacheSize_];
        auto negCache=sinCache[cacheSize_];
        uint8_t stride=dim_/8;
        BinaryRepeatParams broadcast{1,1,1,stride,stride,0};
        BinaryRepeatParams paired{1,1,1,stride,stride,stride};
        for(uint64_t job=begin;job<end;++job) {
            auto input=in_.DeQue<float>();
            if(job+1<end)Prefetch(job+1);
            uint64_t token=job/groups_;
            int32_t position=pos_.GetValue(token);
            uint32_t rows=Rows(job), count=rows*dim_;
            auto output=out_.AllocTensor<float>();
            if(position==0) {
                DataCopy(output,input,count);
            } else {
                if(cached==static_cast<uint64_t>(-1) || token>=cached+cachedCount) {
                    cachedCount=TrigBatch(token,(end-1)/groups_+1,output);
                    cached=token;
                }
                uint32_t trigOffset=(token-cached)*freqSize_;
                auto c=cosCache[trigOffset];auto s=sinCache[trigOffset];auto negs=negCache[trigOffset];
                auto z=input;auto r=output;
                
                for(uint32_t col=0;col<half_;col+=64) {
                    uint64_t mask=half_-col<64?half_-col:64;
                    Mul(r[col],z[col],c[col],mask,rows,broadcast);
                    Mul(r[half_+col],z[half_+col],c[col],mask,rows,broadcast);
                }
                
                for(uint32_t col=0;col<half_;col+=64) {
                    uint64_t mask=half_-col<64?half_-col:64;
                    MulAddDst(r[col],z[half_+col],negs[col],mask,rows,broadcast);
                    MulAddDst(r[half_+col],z[col],s[col],mask,rows,broadcast);
                }
                
            }
            out_.EnQue(output);output=out_.DeQue<float>();
            DataCopyPad(y_[Offset(job)],output,{1,count*uint32_t(sizeof(float)),0,0,0});
            in_.FreeTensor(input);out_.FreeTensor(output);
        }
        PipeBarrier<PIPE_ALL>();
    }
private:
    float theta_;
    TPipe pipe_; TBuf<TPosition::VECCALC> frequencyMath_;
    TQue<QuePosition::VECIN,2> in_;
    TQue<QuePosition::VECOUT,2> out_;
    TBuf<TPosition::VECCALC> trig_;
    GlobalTensor<float> x_,y_;
    GlobalTensor<int32_t> pos_;
    uint64_t tokens_;
    uint32_t heads_,dim_,half_,tileHeads_,groups_,size_,freqSize_,batch_,cacheSize_;
};
template <typename F>
__global__ __vector__ void direct_float_kernel(GM_ADDR x,GM_ADDR p,GM_ADDR y,
    uint64_t tokens,uint32_t heads,uint32_t dim,uint32_t tileHeads,F frequencies) {
    DirectFloatRotary op;op.Init(x,p,y,tokens,heads,dim,tileHeads,frequencies);op.Process<F>();
}

template <typename T> class BulkPositionRotary {
public:
    template <typename F>
    __aicore__ inline void Init(GM_ADDR x,GM_ADDR p,GM_ADDR y,uint64_t tokens,
        uint32_t dim,uint32_t tileTokens,const F& f) {
        x_.SetGlobalBuffer((__gm__ T*)x);y_.SetGlobalBuffer((__gm__ T*)y);
        pos_.SetGlobalBuffer((__gm__ int32_t*)p);
        tokens_=tokens;dim_=dim;half_=dim/2;tile_=tileTokens;size_=tile_*dim;pair_=size_/2;
        pipe_.InitBuffer(in_,2,size_*sizeof(T));pipe_.InitBuffer(out_,2,size_*sizeof(T));
        pipe_.InitBuffer(work_,3*size_*sizeof(float));
        pipe_.InitBuffer(trig_,3*pair_*sizeof(float));
        pipe_.InitBuffer(positionIn_,2,tile_*sizeof(int32_t));
        pipe_.InitBuffer(zeroMask_,(size_+255)/256*32);
        pipe_.InitBuffer(freq_,(half_>256?512:((half_+7)/8*8))*sizeof(float));
        auto freq=freq_.Get<float>();
        FillDeviceFrequencies(pipe_,frequencyMath_,freq,f,half_,(half_+7)/8*8,work_.Get<float>());
    }
    __aicore__ inline uint32_t Rows(uint64_t job) {
        uint64_t n=tokens_-job*tile_;return n<tile_?n:tile_;
    }
    __aicore__ inline void Prefetch(uint64_t job) {
        auto in=in_.AllocTensor<T>();
        DataCopyPad(in,x_[job*tile_*dim_],{1,Rows(job)*dim_*uint32_t(sizeof(T)),0,0,0},
                    DataCopyPadExtParams<T>{false,0,0,0});in_.EnQue(in);
        auto p=positionIn_.AllocTensor<int32_t>();
        DataCopyPad(p,pos_[job*tile_],{1,Rows(job)*uint32_t(sizeof(int32_t)),0,0,0},
                    DataCopyPadExtParams<int32_t>{false,0,0,0});positionIn_.EnQue(p);
    }
    __aicore__ inline void Process() {
        uint64_t jobs=(tokens_+tile_-1)/tile_;
        uint64_t begin=jobs*GetBlockIdx()/GetBlockNum(),end=jobs*(GetBlockIdx()+1)/GetBlockNum();
        if(begin==end)return;
        Prefetch(begin);
        auto z=work_.Get<float>();auto r=z[size_];auto t=z[2*size_];
        auto angle=trig_.Get<float>();auto c=angle[pair_];auto s=angle[2*pair_];
        BinaryRepeatParams pairs{1,1,1,uint8_t(dim_/8),uint8_t(dim_/8),uint8_t(half_/8)};
        BinaryRepeatParams same{1,1,1,uint8_t(dim_/8),uint8_t(dim_/8),uint8_t(dim_/8)};
        for(uint64_t job=begin;job<end;++job) {
            auto input=in_.DeQue<T>();auto positions=positionIn_.DeQue<int32_t>();
            if(job+1<end)Prefetch(job+1);
            uint32_t rows=Rows(job),count=rows*dim_;
            auto pf=positions.template ReinterpretCast<float>();
            Cast(pf,positions,RoundMode::CAST_NONE,(rows+7)/8*8);
            Brcb(z,pf,(rows+7)/8,BrcbRepeatParams{uint16_t(dim_/8),uint16_t(dim_)});
            PipeBarrier<PIPE_V>();
            for(uint32_t built=8;built<dim_;built*=2) {
                uint32_t more=dim_-built<built?dim_-built:built;
                for(uint32_t col=0;col<more;col+=64) {
                    uint32_t mask=more-col<64?more-col:64;
                    Copy(z[built+col],z[col],mask,rows,CopyRepeatParams{1,1,uint16_t(dim_/8),uint16_t(dim_/8)});
                }
                PipeBarrier<PIPE_V>();
            }
            CompareScalar(zeroMask_.Get<uint8_t>(),z,0.0f,CMPMODE::EQ,(count+63)/64*64);
            Mul(angle,z,freq_.Get<float>(),half_,rows,BinaryRepeatParams{1,1,1,uint8_t(half_/8),uint8_t(dim_/8),0});
            SinCosFp32(angle,c,s,z,r,rows*half_);
            LoadFp32(z,input,count);
            
            for(uint32_t col=0;col<half_;col+=64) {
                uint64_t mask=half_-col<64?half_-col:64;
                Mul(r[col],z[col],c[col],mask,rows,pairs);
                Mul(t[col],z[half_+col],s[col],mask,rows,pairs);
                Mul(r[half_+col],z[half_+col],c[col],mask,rows,pairs);
                Mul(t[half_+col],z[col],s[col],mask,rows,pairs);
            }
            
            for(uint32_t col=0;col<half_;col+=64) {
                uint64_t mask=half_-col<64?half_-col:64;
                Sub(r[col],r[col],t[col],mask,rows,same);
                Add(r[half_+col],r[half_+col],t[half_+col],mask,rows,same);
            }
            
            auto output=out_.AllocTensor<T>();
            StoreFp32(output,r,count);
            
            Select(output,zeroMask_.Get<uint8_t>(),input,output,SELMODE::VSEL_TENSOR_TENSOR_MODE,count);
            out_.EnQue(output);output=out_.DeQue<T>();
            DataCopyPad(y_[job*tile_*dim_],output,{1,count*uint32_t(sizeof(T)),0,0,0});
            in_.FreeTensor(input);positionIn_.FreeTensor(positions);out_.FreeTensor(output);
        }
        PipeBarrier<PIPE_ALL>();
    }
private:
    TPipe pipe_; TBuf<TPosition::VECCALC> frequencyMath_;TQue<QuePosition::VECIN,2> in_;TQue<QuePosition::VECOUT,2> out_;TQue<QuePosition::VECIN,2> positionIn_;
    TBuf<TPosition::VECCALC> work_,trig_,freq_,zeroMask_;
    GlobalTensor<T> x_,y_;GlobalTensor<int32_t> pos_;
    uint64_t tokens_;uint32_t dim_,half_,tile_,size_,pair_;
};
template <typename T,typename F=Frequencies>
__global__ __vector__ void bulk_position_kernel(GM_ADDR x,GM_ADDR p,GM_ADDR y,uint64_t tokens,
    uint32_t dim,uint32_t tile,F f) {
    BulkPositionRotary<T> op;op.Init(x,p,y,tokens,dim,tile,f);op.Process();
}

} // namespace rope1743

template <typename FrequencyType>
void LaunchFrequencyMode(GM_ADDR x, const TensorGroupInfo& info_x,
    GM_ADDR positions, const TensorGroupInfo& info_positions, GM_ADDR y,
    const TensorGroupInfo& info_y, int64_t availableCoreNum, aclrtStream stream, float theta);

extern "C" void run_kernel(GM_ADDR x,const TensorGroupInfo& info_x,
    GM_ADDR positions,const TensorGroupInfo& info_positions,GM_ADDR y,
    const TensorGroupInfo& info_y,int64_t availableCoreNum,aclrtStream stream,float theta) {
    uint32_t width=uint32_t(info_x.tensors[0].shape[3])/2;
    bool nearUnity=theta!=1.0f && theta>=1.0f-0x1p-20f && theta<=1.0f+0x1p-20f;
    bool scalar=(width<=32 || nearUnity) && theta>=0x1p-64f && theta<=0x1p64f;
    if(scalar)LaunchFrequencyMode<rope1743::ScalarFrequencyConfig>(
        x,info_x,positions,info_positions,y,info_y,availableCoreNum,stream,theta);
    else LaunchFrequencyMode<rope1743::Frequencies>(
        x,info_x,positions,info_positions,y,info_y,availableCoreNum,stream,theta);
}


template <typename FrequencyType>
void LaunchFrequencyMode(GM_ADDR x, const TensorGroupInfo& info_x,
    GM_ADDR positions, const TensorGroupInfo& info_positions, GM_ADDR y,
    const TensorGroupInfo& info_y, int64_t availableCoreNum, aclrtStream stream, float theta) {
    const auto& shape = info_x.tensors[0].shape;
    uint64_t tokens = static_cast<uint64_t>(shape[0]) * shape[1];
    uint32_t heads = shape[2], dim = shape[3];
    uint32_t width = dim / 2;
    uint32_t pitch = (width + 15) / 16 * 16;
    // Frequency-column partitioning trades a few short DMA bursts for lower
    // per-core initialization and more parallelism in small working sets.
    uint64_t inputBytes=tokens*heads*dim*(info_x.tensors[0].dtype==0?4u:2u);
    if(tokens<128 && inputBytes<=2*1024*1024 && dim<=256 &&
       (heads>1 || tokens<16) && theta>=0x1p-64f && theta<=0x1p64f) {
        uint32_t quantum=info_x.tensors[0].dtype==0?8:16;
        uint32_t splits=1;
        if(dim%(2*quantum)==0) {
            splits=width/quantum;if(splits>8)splits=8;
            uint32_t part=((width+splits-1)/splits+quantum-1)/quantum*quantum;
            splits=(width+part-1)/part;
        } else if(dim>64) splits=0;
        uint32_t available=availableCoreNum>0?availableCoreNum:1;
        uint32_t tile=heads<32?heads:32;
        uint64_t jobs=tokens*((heads+tile-1)/tile);
        if(splits>1) {
            uint32_t maxSplits=(2*available)/jobs;
            if(maxSplits<1)maxSplits=1;
            if(maxSplits>available)maxSplits=available;
            if(splits>maxSplits)splits=maxSplits;
            uint32_t part=((width+splits-1)/splits+quantum-1)/quantum*quantum;
            splits=(width+part-1)/part;
            if(part>32)splits=0;
        }
        if(splits==1)splits=0;
        // A narrow DMA split pays off only when the original row jobs leave
        // at least three quarters of the available AIV cores idle. Otherwise
        // retain the contiguous transfer path and its head reuse.
        if(splits && jobs*4<=available) {
            uint32_t logical=available/splits;if(jobs<logical)logical=jobs;
            uint32_t blocks=logical*splits;
            if(info_x.tensors[0].dtype==0)
                rope1743::small_kernel<float><<<blocks,nullptr,stream>>>(x,positions,y,tokens,heads,dim,tile,splits,theta);
            else
                rope1743::small_kernel<half><<<blocks,nullptr,stream>>>(x,positions,y,tokens,heads,dim,tile,splits,theta);
            return;
        }
    }
    bool aligned = (dim % 16 == 0);
    uint32_t tileElements = dim>=512 ? (info_x.tensors[0].dtype==0?8192:12288) :
        (info_x.tensors[0].dtype==0?4096:11264);
    bool directFloat = aligned && info_x.tensors[0].dtype==0 && !(heads==1 && tokens>=16);
    if(directFloat && tokens>=128)tileElements=8192;
    uint32_t tileHeads = aligned ? tileElements / dim : 4096 / pitch;
    if (tileHeads > (aligned ? 192u : 32u)) tileHeads = aligned ? 192 : 32;
    if (tileHeads > heads) tileHeads = heads;
    if(aligned) {
        uint32_t groups=(heads+tileHeads-1)/tileHeads;
        tileHeads=(heads+groups-1)/groups;
    }
    bool batched = aligned && heads == 1 && tokens >= 16;
    uint32_t tileTokens = 2048 / (dim / 2);
    // Wide H=1: allocate below 180 KiB, including four queue slots,
    // three FP32 work arrays, three half-width trig arrays and frequencies.
    // Only the batch size changes; FP32 instruction order is unchanged.
    if (batched && dim > 512)
        tileTokens = (180 * 1024 - 2048) /
            (dim * (info_x.tensors[0].dtype == 0 ? 34u : 26u));
    if (tileTokens > 64) tileTokens = 64;
    uint64_t jobs = batched ? (tokens + tileTokens - 1) / tileTokens :
                             tokens * ((heads + tileHeads - 1) / tileHeads);
    uint32_t cores = availableCoreNum > 0 ? availableCoreNum : 1;
    if (jobs < cores) cores = jobs;

    if(aligned && dim<=128 && heads==1 && tokens>=128) {
        uint32_t tile=tileTokens/8*8;if(tile<8)tile=8;
        uint64_t bulkJobs=(tokens+tile-1)/tile;
        uint32_t bulkCores=availableCoreNum>0?availableCoreNum:1;
        if(bulkJobs<bulkCores)bulkCores=bulkJobs;
        FrequencyType frequencies{};
        frequencies.theta=theta;
        if(info_x.tensors[0].dtype==0)
            rope1743::bulk_position_kernel<float,FrequencyType><<<bulkCores,nullptr,stream>>>(x,positions,y,tokens,dim,tile,frequencies);
        else
            rope1743::bulk_position_kernel<half,FrequencyType><<<bulkCores,nullptr,stream>>>(x,positions,y,tokens,dim,tile,frequencies);
        return;
    }
    if(dim%16!=0 && dim<=64 && heads>32 && tokens>=128) {
        uint32_t tile=2048/pitch;if(tile>128)tile=128;if(tile>heads)tile=heads;
        uint64_t headJobs=tokens*((heads+tile-1)/tile);
        uint32_t headCores=availableCoreNum>0?availableCoreNum:1;
        if(headJobs<headCores)headCores=headJobs;
        FrequencyType f{};
        f.theta=theta;
        if(info_x.tensors[0].dtype==0)
            rope1743::head_tile_kernel<float,FrequencyType><<<headCores,nullptr,stream>>>(x,positions,y,tokens,heads,dim,tile,f);
        else
            rope1743::head_tile_kernel<half,FrequencyType><<<headCores,nullptr,stream>>>(x,positions,y,tokens,heads,dim,tile,f);
        return;
    }
    if (dim<=128 && heads<=32 && tokens>=128 &&
        (dim%16!=0 || (dim==16 && heads>1 && heads<=8))) {
        uint32_t tile=2048/(heads*pitch);
        if(tile>64)tile=64;
        uint64_t packedJobs=(tokens+tile-1)/tile;
        uint32_t packedCores=availableCoreNum>0?availableCoreNum:1;
        if(packedJobs<packedCores)packedCores=packedJobs;
        FrequencyType frequencies{};
        frequencies.theta=theta;
        if(info_x.tensors[0].dtype==0)
            rope1743::packed_kernel<float,FrequencyType><<<packedCores,nullptr,stream>>>(x,positions,y,tokens,heads,dim,tile,frequencies);
        else
            rope1743::packed_kernel<half,FrequencyType><<<packedCores,nullptr,stream>>>(x,positions,y,tokens,heads,dim,tile,frequencies);
        return;
    }
    if (dim > 512) {
        FrequencyType frequencies{};
        frequencies.theta=theta;
        if(batched) {
            if(info_x.tensors[0].dtype==0)
                rope1743::wide_batched_kernel<float,FrequencyType><<<cores,nullptr,stream>>>(x,positions,y,tokens,dim,tileTokens,frequencies);
            else
                rope1743::wide_batched_kernel<half,FrequencyType><<<cores,nullptr,stream>>>(x,positions,y,tokens,dim,tileTokens,frequencies);
        } else if(directFloat) {
            rope1743::direct_float_kernel<FrequencyType><<<cores,nullptr,stream>>>(
                x,positions,y,tokens,heads,dim,tileHeads,frequencies);
        } else if(aligned) {
            if(info_x.tensors[0].dtype==0)
                rope1743::large_wide_kernel<float,FrequencyType><<<cores,nullptr,stream>>>(x,positions,y,tokens,heads,dim,tileHeads,frequencies);
            else
                rope1743::large_wide_kernel<half,FrequencyType><<<cores,nullptr,stream>>>(x,positions,y,tokens,heads,dim,tileHeads,frequencies);
        } else if(info_x.tensors[0].dtype==0)
            rope1743::wide_kernel<float,FrequencyType><<<cores,nullptr,stream>>>(x,positions,y,tokens,heads,dim,tileHeads,frequencies);
        else
            rope1743::wide_kernel<half,FrequencyType><<<cores,nullptr,stream>>>(x,positions,y,tokens,heads,dim,tileHeads,frequencies);
        return;
    }

    FrequencyType frequencies{};
    frequencies.theta=theta;
    if (batched) {
        if (info_x.tensors[0].dtype == 0)
            rope1743::batched_kernel<float,FrequencyType><<<cores, nullptr, stream>>>(
                x, positions, y, tokens, dim, tileTokens, frequencies);
        else
            rope1743::batched_kernel<half,FrequencyType><<<cores, nullptr, stream>>>(
                x, positions, y, tokens, dim, tileTokens, frequencies);
    } else if (directFloat) {
        rope1743::direct_float_kernel<FrequencyType><<<cores,nullptr,stream>>>(
            x,positions,y,tokens,heads,dim,tileHeads,frequencies);
    } else if (aligned && dim>=512) {
        if (info_x.tensors[0].dtype == 0)
            rope1743::large_aligned_kernel<float,FrequencyType><<<cores, nullptr, stream>>>(
                x, positions, y, tokens, heads, dim, tileHeads, frequencies);
        else
            rope1743::large_aligned_kernel<half,FrequencyType><<<cores, nullptr, stream>>>(
                x, positions, y, tokens, heads, dim, tileHeads, frequencies);
    } else if (aligned) {
        if (info_x.tensors[0].dtype == 0)
            rope1743::aligned_kernel<float,FrequencyType><<<cores, nullptr, stream>>>(
                x, positions, y, tokens, heads, dim, tileHeads, frequencies);
        else
            rope1743::aligned_kernel<half,FrequencyType><<<cores, nullptr, stream>>>(
                x, positions, y, tokens, heads, dim, tileHeads, frequencies);
    } else if (info_x.tensors[0].dtype == 0) {
        rope1743::rotary_kernel<float,FrequencyType><<<cores, nullptr, stream>>>(
            x, positions, y, tokens, heads, dim, 0, width, tileHeads, frequencies);
    } else {
        rope1743::rotary_kernel<half,FrequencyType><<<cores, nullptr, stream>>>(
            x, positions, y, tokens, heads, dim, 0, width, tileHeads, frequencies);
    }
}
// END_ROPE1743_V10_WIDE_FMADD
