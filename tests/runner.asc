#include <algorithm>
#include <chrono>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <fstream>
#include <string>
#include <vector>
#include "acl/acl.h"
struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
#include "kernel.asc"
#define CHECK(expr) do { auto ret=(expr); if(ret!=ACL_SUCCESS) { fprintf(stderr,"%s: %d\n",#expr,int(ret)); return 2; } } while(0)
int main(int argc,char** argv) {
    int device=0, warmup=5, repeat=30, batches=3, dtype=0;
    int64_t shape[4]={1,7,1,16};
    float theta=10000;
    std::string input="input",output="output/y.bin";
    for(int i=1;i<argc;++i) {
        std::string key=argv[i];
        if(key=="--shape") {for(int d=0;d<4;++d)shape[d]=std::stoll(argv[++i]);}
        else if(key=="--device") device=std::stoi(argv[++i]);
        else if(key=="--dtype") dtype=std::string(argv[++i])=="float16"?1:0;
        else if(key=="--theta") theta=std::stof(argv[++i]);
        else if(key=="--input") input=argv[++i];
        else if(key=="--output") output=argv[++i];
        else if(key=="--warmup") warmup=std::stoi(argv[++i]);
        else if(key=="--repeat") repeat=std::stoi(argv[++i]);
        else if(key=="--batches") batches=std::stoi(argv[++i]);
        else {fprintf(stderr,"unknown argument %s\n",key.c_str());return 2;}
    }
    int64_t num=shape[0]*shape[1]*shape[2]*shape[3];
    size_t bytes=num*(dtype==0?4:2), posBytes=shape[0]*shape[1]*4;
    std::vector<uint8_t> hx(bytes), hp(posBytes), hy(bytes+256,0xa5);
    auto read=[](const std::string& path,std::vector<uint8_t>& v) {
        std::ifstream f(path,std::ios::binary); f.read((char*)v.data(),v.size());
        return f.gcount()==static_cast<std::streamsize>(v.size());
    };
    if(!read(input+"/x.bin",hx)||!read(input+"/positions.bin",hp)) {fprintf(stderr,"invalid input files\n");return 2;}
    CHECK(aclInit(nullptr)); CHECK(aclrtSetDevice(device));
    int64_t cores=0; CHECK(aclrtGetDeviceInfo(device,ACL_DEV_ATTR_VECTOR_CORE_NUM,&cores));
    fprintf(stderr,"soc=%s device=%d vector_cores=%ld\n",aclrtGetSocName(),device,cores);
    aclrtStream stream; CHECK(aclrtCreateStream(&stream));
    void *dx,*dp,*dyBase;
    CHECK(aclrtMalloc(&dx,bytes,ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK(aclrtMalloc(&dp,posBytes,ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK(aclrtMalloc(&dyBase,bytes+256,ACL_MEM_MALLOC_HUGE_FIRST));
    auto dy=(uint8_t*)dyBase+128;
    CHECK(aclrtMemcpy(dx,bytes,hx.data(),bytes,ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK(aclrtMemcpy(dp,posBytes,hp.data(),posBytes,ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK(aclrtMemcpy(dyBase,bytes+256,hy.data(),bytes+256,ACL_MEMCPY_HOST_TO_DEVICE));
    TensorInfo xi{shape,4,dtype},pi{shape,2,5},yi{shape,4,dtype};
    TensorGroupInfo ix{&xi,1},ip{&pi,1},iy{&yi,1};
    auto launch=[&](){run_kernel((GM_ADDR)dx,ix,(GM_ADDR)dp,ip,(GM_ADDR)dy,iy,cores,stream,theta);};
    for(int i=0;i<warmup;++i)launch();
    CHECK(aclrtSynchronizeStreamWithTimeout(stream,30000));
    aclrtEvent start,end; CHECK(aclrtCreateEvent(&start)); CHECK(aclrtCreateEvent(&end));
    std::vector<float> measurements;
    auto wallStart=std::chrono::steady_clock::now();
    for(int b=0;b<batches;++b) {
        CHECK(aclrtRecordEvent(start,stream));
        for(int i=0;i<repeat;++i)launch();
        CHECK(aclrtRecordEvent(end,stream));
        CHECK(aclrtSynchronizeStreamWithTimeout(stream,30000));
        float ms=0;CHECK(aclrtEventElapsedTime(&ms,start,end));
        measurements.push_back(ms*1000/repeat);
    }
    auto wallEnd=std::chrono::steady_clock::now();
    CHECK(aclrtMemcpy(hy.data(),bytes+256,dyBase,bytes+256,ACL_MEMCPY_DEVICE_TO_HOST));
    for(size_t i=0;i<128;++i) if(hy[i]!=0xa5||hy[bytes+128+i]!=0xa5) {fprintf(stderr,"output guard corrupted\n");return 3;}
    std::ofstream out(output,std::ios::binary);out.write((char*)hy.data()+128,bytes);out.close();
    if(!out) {fprintf(stderr,"cannot write output\n");return 2;}
    std::sort(measurements.begin(),measurements.end());
    printf("{\"event_us\":%.6f,\"min_event_us\":%.6f,\"host_us\":%.6f,\"cores\":%ld,\"soc\":\"%s\",\"guard_ok\":true}\n",
        measurements[measurements.size()/2], measurements[0],
        std::chrono::duration<double,std::micro>(wallEnd-wallStart).count()/(repeat*batches),cores,aclrtGetSocName());
    CHECK(aclrtDestroyEvent(start)); CHECK(aclrtDestroyEvent(end));
    CHECK(aclrtFree(dx));CHECK(aclrtFree(dp));CHECK(aclrtFree(dyBase));
    CHECK(aclrtDestroyStream(stream));CHECK(aclrtResetDevice(device));CHECK(aclFinalize());
}
