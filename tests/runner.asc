#include <algorithm>
#include <chrono>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <fstream>
#include <string>
#include <sstream>
#include <vector>
#include "acl/acl.h"
#include "launch_audit.h"
struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
#include "kernel.asc"
#define CHECK(expr) do { auto ret=(expr); if(ret!=ACL_SUCCESS) { fprintf(stderr,"%s: %d\n",#expr,int(ret)); return 2; } } while(0)
int RunCase(int argc,char** argv,bool initialized=false) {
    int device=0, warmup=5, repeat=30, batches=3, dtype=0;
    int64_t shape[4]={1,7,1,16};
    float theta=10000;
    std::string input="input",output="output/y.bin";
    for(int i=1;i<argc;++i) {
        std::string key=argv[i];
        if(key=="--shape") {for(int d=0;d<4;++d)shape[d]=std::stoll(argv[++i]);}
        else if(key=="--device") device=std::stoi(argv[++i]);
        else if(key=="--dtype") dtype=std::string(argv[++i])=="float16"?1:0;
        else if(key=="--theta") theta=std::stof(argv[++i]);
        else if(key=="--input") input=argv[++i];
        else if(key=="--output") output=argv[++i];
        else if(key=="--warmup") warmup=std::stoi(argv[++i]);
        else if(key=="--repeat") repeat=std::stoi(argv[++i]);
        else if(key=="--batches") batches=std::stoi(argv[++i]);
        else {fprintf(stderr,"unknown argument %s\n",key.c_str());return 2;}
    }
    int64_t num=shape[0]*shape[1]*shape[2]*shape[3];
    constexpr size_t guardBytes=512;
    size_t bytes=num*(dtype==0?4:2), posBytes=shape[0]*shape[1]*4;
    std::vector<uint8_t> hx(bytes), hp(posBytes), hy(bytes+2*guardBytes,0xa5);
    auto read=[](const std::string& path,std::vector<uint8_t>& v) {
        std::ifstream f(path,std::ios::binary); f.read((char*)v.data(),v.size());
        return f.gcount()==static_cast<std::streamsize>(v.size());
    };
    if(!read(input+"/x.bin",hx)||!read(input+"/positions.bin",hp)) {fprintf(stderr,"invalid input files\n");return 2;}
    if(!initialized) {CHECK(aclInit(nullptr)); CHECK(aclrtSetDevice(device));}
    int64_t cores=0; CHECK(aclrtGetDeviceInfo(device,ACL_DEV_ATTR_VECTOR_CORE_NUM,&cores));
    fprintf(stderr,"soc=%s device=%d vector_cores=%ld\n",aclrtGetSocName(),device,cores);
    aclrtStream stream; CHECK(aclrtCreateStream(&stream));
    void *dx,*dp,*dyBase;
    CHECK(aclrtMalloc(&dx,bytes,ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK(aclrtMalloc(&dp,posBytes,ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK(aclrtMalloc(&dyBase,bytes+2*guardBytes,ACL_MEM_MALLOC_HUGE_FIRST));
    auto dy=(uint8_t*)dyBase+guardBytes;
    CHECK(aclrtMemcpy(dx,bytes,hx.data(),bytes,ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK(aclrtMemcpy(dp,posBytes,hp.data(),posBytes,ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK(aclrtMemcpy(dyBase,bytes+2*guardBytes,hy.data(),bytes+2*guardBytes,ACL_MEMCPY_HOST_TO_DEVICE));
    if(reinterpret_cast<uintptr_t>(dy)%512!=0) {fprintf(stderr,"output alignment is not 512 bytes\n");return 3;}
    TensorInfo xi{shape,4,dtype},pi{shape,2,5},yi{shape,4,dtype};
    TensorGroupInfo ix{&xi,1},ip{&pi,1},iy{&yi,1};
    uint64_t iterations=0;
    auto launch=[&](){
#ifdef ROPE_LAUNCH_AUDIT
        uint64_t before=ropeActualKernelLaunches;
#endif
        run_kernel((GM_ADDR)dx,ix,(GM_ADDR)dp,ip,(GM_ADDR)dy,iy,cores,stream,theta);
        ++iterations;
#ifdef ROPE_LAUNCH_AUDIT
        uint64_t count=ropeActualKernelLaunches-before;
        if(count!=1) {
            fprintf(stderr,"iteration %llu: expected 1 kernel launch, got %llu; dim=%ld dtype=%d\n",
                (unsigned long long)iterations,(unsigned long long)count,shape[3],dtype);
            return false;
        }
#endif
        return true;
    };
    for(int i=0;i<warmup;++i)if(!launch())return 4;
    CHECK(aclrtSynchronizeStreamWithTimeout(stream,30000));
    aclrtEvent start,end; CHECK(aclrtCreateEvent(&start)); CHECK(aclrtCreateEvent(&end));
    std::vector<float> measurements;
    auto wallStart=std::chrono::steady_clock::now();
    for(int b=0;b<batches;++b) {
        CHECK(aclrtRecordEvent(start,stream));
        for(int i=0;i<repeat;++i)if(!launch())return 4;
        CHECK(aclrtRecordEvent(end,stream));
        CHECK(aclrtSynchronizeStreamWithTimeout(stream,30000));
        float ms=0;CHECK(aclrtEventElapsedTime(&ms,start,end));
        measurements.push_back(ms*1000/repeat);
    }
    auto wallEnd=std::chrono::steady_clock::now();
    CHECK(aclrtMemcpy(hy.data(),bytes+2*guardBytes,dyBase,bytes+2*guardBytes,ACL_MEMCPY_DEVICE_TO_HOST));
    for(size_t i=0;i<guardBytes;++i) if(hy[i]!=0xa5||hy[bytes+guardBytes+i]!=0xa5) {fprintf(stderr,"output guard corrupted\n");return 3;}
    std::ofstream out(output,std::ios::binary);out.write((char*)hy.data()+guardBytes,bytes);out.close();
    if(!out) {fprintf(stderr,"cannot write output\n");return 2;}
    std::sort(measurements.begin(),measurements.end());
    printf("{\"event_us\":%.6f,\"min_event_us\":%.6f,\"host_us\":%.6f,\"cores\":%ld,\"soc\":\"%s\",\"device\":%d,\"guard_ok\":true",
        measurements[measurements.size()/2], measurements[0],
        std::chrono::duration<double,std::micro>(wallEnd-wallStart).count()/(repeat*batches),cores,aclrtGetSocName(),device);
#ifdef ROPE_LAUNCH_AUDIT
    printf(",\"launch_audit\":true,\"iterations\":%llu,\"kernel_launches\":%llu,\"one_kernel_per_iteration\":true",
        (unsigned long long)iterations,(unsigned long long)iterations);
#endif
    printf(",\"output_alignment_bytes\":512}\n");
    CHECK(aclrtDestroyEvent(start)); CHECK(aclrtDestroyEvent(end));
    CHECK(aclrtFree(dx));CHECK(aclrtFree(dp));CHECK(aclrtFree(dyBase));
    CHECK(aclrtDestroyStream(stream));
    if(!initialized) {CHECK(aclrtResetDevice(device));CHECK(aclFinalize());}
    return 0;
}

int main(int argc,char** argv) {
    std::string batch;int device=0;
    for(int i=1;i<argc;++i) {
        if(std::string(argv[i])=="--batch" && i+1<argc)batch=argv[++i];
        else if(std::string(argv[i])=="--device" && i+1<argc)device=std::stoi(argv[++i]);
    }
    if(batch.empty())return RunCase(argc,argv);
    std::ifstream f(batch);
    if(!f) {fprintf(stderr,"cannot read batch manifest\n");return 2;}
    CHECK(aclInit(nullptr));CHECK(aclrtSetDevice(device));
    std::string line;
    while(std::getline(f,line)) {
        std::istringstream stream(line);std::string arg;
        std::vector<std::string> words={argv[0],"--device",std::to_string(device)};
        while(stream>>arg)words.push_back(arg);
        if(words.size()==3)continue;
        std::vector<char*> args;
        for(auto& word:words)args.push_back(&word[0]);
        int ret=RunCase(args.size(),args.data(),true);
        if(ret)return ret;
    }
    CHECK(aclrtResetDevice(device));CHECK(aclFinalize());return 0;
}
